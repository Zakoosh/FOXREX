# FOXREX Studio generation worker — no provider secrets live here.
# Higgsfield credentials are stored by the official CLI after `higgsfield auth login`.
PORT=8787
HOST=127.0.0.1
# Shared secret between the FOXREX site backend (or the Studio) and this worker.
STUDIO_WORKER_TOKEN=change-me-long-random-string
# Exact origin(s) allowed to call the worker from the browser, comma-separated, no path or trailing slash.
# Hosted Studio: https://foxrex.co  ·  local preview: http://localhost:5173  ·  leave empty when proxied same-origin
ALLOWED_ORIGIN=http://localhost:5173
DATA_DIR=./data
# Path to the official Higgsfield CLI binary
HIGGSFIELD_BIN=higgsfield
# Image model preference (capability routing picks the first compatible one)
HF_IMAGE_MODELS=nano_banana_2,gpt_image_2_5
# Video/Reel scene generation is Phase 3 — keep disabled
ENABLE_VIDEO=false
# Estimate credits with `higgsfield generate cost` before each job
ESTIMATE_COST=true

# Creative reasoning is independent of image generation. Local, opt-in, no paid APIs.
CREATIVE_PROVIDER=disabled
CREATIVE_MODEL=
CREATIVE_URL=http://127.0.0.1:11434
