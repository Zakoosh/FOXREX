# FOXREX Studio generation worker — no provider secrets live here.
# Higgsfield credentials are stored by the official CLI after `higgsfield auth login`.
PORT=8787
HOST=127.0.0.1
# Shared secret between the FOXREX site backend (or the Studio) and this worker.
STUDIO_WORKER_TOKEN=change-me-long-random-string
# Exact origin(s) allowed to call the worker from the browser, comma-separated, no path or trailing slash.
# Hosted Studio: https://foxrex.co  ·  local preview: http://localhost:5173  ·  leave empty when proxied same-origin
ALLOWED_ORIGIN=http://localhost:5173
DATA_DIR=./data
# Path to the official Higgsfield CLI binary
HIGGSFIELD_BIN=higgsfield
# Image model preference (capability routing picks the first compatible one)
HF_IMAGE_MODELS=nano_banana_2,gpt_image_2_5
# Video/Reel scene generation is Phase 3 — keep disabled
ENABLE_VIDEO=false
# Estimate credits with `higgsfield generate cost` before each job
ESTIMATE_COST=true

# Creative reasoning is independent of image generation. Local, opt-in, no paid APIs.
CREATIVE_PROVIDER=disabled
CREATIVE_MODEL=
CREATIVE_URL=http://127.0.0.1:11434

# ---- Publishing engine (Studio -> foxrex.co). See docs/PUBLISHING.md ----
# dry-run (default): validate, build the candidate feed, run checks, show the diff. Never writes, commits or pushes.
# live: after an explicit, approved, confirmed Studio action, commit data/content.json and push (never force).
PUBLISH_MODE=dry-run
# A DEDICATED clean clone of Zakoosh/FOXREX used only by the engine (never your working copy).
# Pushes use THIS machine's git credentials (SSH deploy key or credential helper) — never stored here.
PUBLISH_REPO_DIR=../../foxrex-publish
PUBLISH_BRANCH=main
PUBLISH_REMOTE=origin
PUBLISH_CHECKS=node tools/site/check-feed.mjs {feed};node --test worker/test/site.test.mjs
PUBLIC_FEED_URL=https://foxrex.co/data/content.json
# Automatic execution of SCHEDULED items. Only enable on an always-on host.
SCHEDULER_ENABLED=false
# Missed-schedule policy: a time-sensitive market item (Morning Brief, Gold Focus, Event, US Open, Market Recap)
# that is later than this many minutes is NOT auto-published; it is flagged MISSED for an operator decision.
SCHEDULE_GRACE_MINUTES=15
# Same policy for evergreen types (Learn, REX…), in minutes (24 h).
SCHEDULE_GRACE_MINUTES_OTHER=1440
# Public repository name used only to read GitHub Pages run status (public API, no token).
GITHUB_REPO=Zakoosh/FOXREX

# ---- Durability ----
# CMS backups (records, publications, audit log). Default DATA_DIR/backups. Point at another PRIVATE disk if possible.
BACKUP_DIR=
BACKUP_KEEP=72
BACKUP_MIN_INTERVAL_MINUTES=10
# Optional log file with rotation (5 MB x 5). Leave empty under systemd/launchd (they capture stdout).
LOG_FILE=

# ---- Market Data Layer (docs/MARKET-DATA.md) ----
# Credentials live ONLY here (worker/server env). Never in Studio, the website or Git.
# Ordered provider priority, comma-separated: oanda, twelvedata, coinbase, bridge. Empty = disabled
# (the website keeps its honest "Market feed not connected" state).
MARKET_PROVIDERS=
# Generic key for the FIRST provider in MARKET_PROVIDERS (provider-specific variables take precedence).
MARKET_API_KEY=
# Public symbols served by the Market API (registry: worker/src/market/symbols.js).
MARKET_SYMBOLS=XAUUSD,EURUSD,GBPUSD,USDJPY,BTCUSD,DXY
# OANDA v20 (bid/ask; FX, metals, index/energy CFDs). practice | live
OANDA_API_TOKEN=
OANDA_ACCOUNT_ID=
OANDA_ENV=practice
# Twelve Data (last price + provider previous-close change). Set REALTIME=true only if your plan is real-time.
TWELVEDATA_API_KEY=
TWELVEDATA_REALTIME=false
# Operator-owned MT5/broker bridge: GET <URL>/quotes?symbols=A,B → {quotes:[{symbol,bid,ask,time}]}
MARKET_BRIDGE_URL=
MARKET_BRIDGE_TOKEN=
MARKET_BRIDGE_LABEL=Broker bridge
# Provider symbol overrides, e.g. bridge:XAUUSD=XAUUSD.m;bridge:EURUSD=EURUSD.m
MARKET_SYMBOL_MAP=
# Poll intervals (seconds) — respect your plan's rate limits. Visitors never trigger provider calls.
MARKET_POLL_SECONDS_OANDA=5
MARKET_POLL_SECONDS_TWELVEDATA=120
MARKET_POLL_SECONDS_COINBASE=10
MARKET_TIMEOUT_MS=8000
MARKET_MAX_BACKOFF_SECONDS=600
# Reject provider timestamps further than this in the future (clock-skew tolerance).
MARKET_FUTURE_TOLERANCE_MS=10000
# Browser origins allowed to read the public Market API (exact; never *).
MARKET_PUBLIC_ORIGINS=https://foxrex.co
# Use CF-Connecting-IP for per-visitor rate limits when behind Cloudflare Tunnel.
MARKET_TRUST_PROXY=
# Optional market-only listener for a public tunnel (serves /health + /api/market/* only).
MARKET_PORT=8788
