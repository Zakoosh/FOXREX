float  fZone   = input.float(0.618, "Zone end (fib)", minval = 0.236, maxval = 0.95, step = 0.001, group = G_WAV, tooltip = "Zone 38.2% – 61.8% of the wave. Your fib template 38.2 / 50 / 61.8 / 65.7: set 0.657 here and Entry level = Fib level 0.559.", display = display.none)
