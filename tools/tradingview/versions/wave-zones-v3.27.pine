// FOXREX · Wave Retracement Zones · version 3.27 (see tools/tradingview/CHANGELOG.md)
// Strategy: a wave runs from its start to the first price stall. Its retracement (38.2%–61.8%) is the trade zone —
// buy the pullbacks of an up trend, sell the pullbacks of a down trend, add on the next pullbacks of the same wave.
// Trend (default): up while price holds above the last higher low; a close below it turns the trend down (mirror).
// Trading mode: Strict (default) · Balanced · Open · Custom — see the tooltip of "Trading mode".
// On the chart:
//   • Local zones  — this timeframe: grey fill, dashed border, "M1 BUY ZONE".
//   • Major zone   — the timeframe that trades with this chart (1m→15m, 5m→15m, 15m→4H, 1H→D): solid border, "MAJOR".
//   • HTF guide    — live zones of 5m / 15m / 1H / 4H (only those above this chart), thicker border for a higher
//                    timeframe, plus their entry markers, open trades and a panel with trend / RSI / MACD of each.
//                    The guide is a map: it does not open trades on this chart.
//   • Daily zones  — today's support (buy) / resistance (sell) bands.
// Simulation (indicator, not a broker): limits fill when price reaches the level after the zone exists; the result
// is in points and $ with partial closes, commission and spread. Higher timeframes are read from their last closed
// bar. Zones and stall marks are confirmed one bar after the stall, so they are drawn from where they are known.
// Educational tool, not investment advice.

//@version=6
indicator("FOXREX · Wave Retracement Zones", shorttitle = "FX Waves", overlay = true, max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500, max_bars_back = 500)
string VER = "3.27"

// ───────────────────────────── Inputs (most important first)
string G_Q    = "⭐ 1 · Quick setup — size · stop · targets · conditions · blockers"
string modeIn  = input.string("Strict", "Trading mode", options = ["Strict", "Balanced", "Open", "Custom (use the settings below)"], group = G_Q, tooltip = "Strict (default): with the trend only, ★★ minimum, no counter-trend, major zones only when this chart and the major trend agree, trend lines from 15m.\nBalanced: trend first; RSI stretch allowed while the MACD momentum is still building; no counter-trend wave zones.\nOpen: also counter-trend wave zones with ★★ (half size, closed at TP1), limit at the zone start, room filter half size.\nCustom: section 4 as set.", display = display.none)
float  lot1a   = input.float(3.0, "Size · 1m lots ★ → ★★★★", minval = 0.01, step = 0.5, group = G_Q, inline = "l1", display = display.none)
float  lot1b   = input.float(5.0, "", minval = 0.01, step = 0.5, group = G_Q, inline = "l1", tooltip = "1m: small targets, bigger size: from this many lots for one star up to this many for four stars.", display = display.none)
bool   lotStar = input.bool(true, "Size · by stars (other timeframes 1 / 1.5 / 2 / 2.5 lots)", group = G_Q, display = display.none)
string stopMd  = input.string("ATR: 1.5 – 2 × behind the zone", "Stop · distance", options = ["ATR: 1.5 – 2 × behind the zone", "Points per timeframe (3.13)"], group = G_Q, tooltip = "ATR: the stop sits behind the zone and is kept between the two ATR(14) multiples below. Points: the per-timeframe table in section 6.", display = display.none)
float  slAtrA  = input.float(1.5, "Stop · ATR min / max", minval = 0.2, step = 0.1, group = G_Q, inline = "sa", display = display.none)
float  slAtrB  = input.float(2.0, "", minval = 0.3, step = 0.1, group = G_Q, inline = "sa", display = display.none)
string profile = input.string("Auto by timeframe", "Targets · profile", options = ["Auto by timeframe", "Auto by ATR (1m ratios)", "Custom"], group = G_Q, tooltip = "Auto by timeframe: 1m TP 1/2/3/5 · 5m TP 2.5/5/10/15 · 15m TP 2.5/5/10/20 · 1H/4H TP 5/10/20/40 · D+ TP 10/20/40/80. Major / daily zone trades use at least the 5m targets.\nAuto by ATR: TP 0.7 / 1.4 / 2.1 / 3.5 × ATR on every timeframe.\nCustom: the values in section 5.", display = display.none)
string partPct = input.string("25", "Targets · % closed at TP1, TP2, … (rest runs to TP7)", group = G_Q, tooltip = "A list: \"25\" = 25% of the size at TP1 only, the rest runs. \"25,25,25\" = 25% at TP1, TP2 and TP3. Same ladder as the MT5 EA.", display = display.none)
string protect = input.string("Step: entry after TP1, then previous target", "Targets · profit protection", options = ["After TP2: stop to entry, then one target behind", "After TP2: stop to entry, after TP3: to TP1", "Step: entry after TP1, then previous target", "Entry after TP1 only", "Off (keep the original stop)"], group = G_Q, display = display.none)
int    ms1     = input.int(1, "Conditions · min stars  1m / 2–5m / 6–30m / above", options = [1, 2, 3], group = G_Q, inline = "ms", tooltip = "Stars = stall candles that hold near the top of the wave (+1 when RSI was stretched the right way). Strict mode never trades below ★★.", display = display.none)
int    ms5     = input.int(1, "", options = [1, 2, 3], group = G_Q, inline = "ms", display = display.none)
int    ms15    = input.int(1, "", options = [1, 2, 3], group = G_Q, inline = "ms", display = display.none)
int    msH     = input.int(1, "", options = [1, 2, 3], group = G_Q, inline = "ms", display = display.none)
int    maxOpen = input.int(3, "Conditions · max open trades (reinforcement, 0 = no limit)", minval = 0, group = G_Q, tooltip = "Reinforcement adds on the next pullbacks of the same wave only while every open trade is protected (stop at entry or better). This caps how many can be open at once.", display = display.none)
bool   useRsi  = input.bool(true, "Blocker · RSI: no buy overbought / sell oversold (unless ★★★ or a strong level broke)", group = G_Q, display = display.none)
string roomMode = input.string("Auto (by mode)", "Blocker · room: strong support / resistance in the way", options = ["Auto (by mode)", "Strong zones only · block", "Strong zones only · half size", "All daily zones · block", "Off"], group = G_Q, tooltip = "Less than TP1 of room before a strong daily zone (or a major zone price is reacting in) → block or half size. Auto: block (Open mode: half size).", display = display.none)
bool   smOn    = input.bool(true, "Blocker · no support / resistance trade against a strong move", group = G_Q, tooltip = "After a fall of 3 × ATR in 20 bars with the MACD falling, no buy at a support until the trend turns up. Mirror for sells.", display = display.none)
bool   useSpk  = input.bool(true, "Blocker · skip signals after an abnormal candle", group = G_Q, display = display.none)

