// FOXREX · Wave Retracement Zones (v8)
// Three kinds of buy / sell zones, each with its own look so nothing overlaps:
//   • Local zones  — the chart's timeframe: grey fill, dashed border in the side colour, "M5 BUY ZONE".
//   • Major zones  — a higher timeframe that sets the direction (auto: 1m→15m, 5m→1H, 15m→4H, 1H→D):
//                    coloured fill, solid border, "H1 BUY ZONE · MAJOR". A local zone that sits inside a
//                    major zone of the same side is not drawn twice.
//   • Daily zones  — today's daily support (buy) / resistance (sell): light band with the name at the right edge.
// Zones: break of structure → retracement of the impulse leg between 50% and 61.8%. Fib 0% = the first stall
// after the break when the wave is clean, otherwise the swing before the break. At most two live zones per side
// per timeframe; finished zones are removed (option to keep them).
// Trades come only from these zones:
//   • local zone: limit at the middle of the zone or a rejection candle in it, whichever comes first;
//   • major zone: same rule on the major zone, seen on the chart timeframe;
//   • daily zone: a candle that dips into the zone and closes back out of it (rejection).
// Every timeframe trades its own setups: a short-term move against the bigger wave is allowed (the direction
// filter is off by default). One trade at a time per timeframe; a new signal never closes it.
// Targets and stops follow the timeframe (auto profile) — the stop sits beyond the zone, capped:
//   1m  TP 1 / 2 / 3 / 5      stop up to 5    (quick scalps)
//   5m  TP 2.5 / 5 / 10 / 15  stop up to 10
//   15m TP 2.5 / 5 / 10 / 20  stop up to 10
//   1H / 4H TP 5 / 10 / 20 / 40  stop up to 15    D/W/M: TP 10 / 20 / 40 / 80, stop up to 25
//   Trades from major and daily zones use at least the 5m targets.
// Simulation: every trade = 1 lot, no spread, commission per lot (default $6); P&L in $ on the label and scorecard.
// A trade that has not reached TP1 within "No-progress exit" bars is closed at market (time exit), and every
// trade is closed after "Maximum trade life" bars. Profit protection: stop to entry after TP1, to TP1 after
// TP2, to TP2 after TP3. A trade that touched a target is a win and is recorded as that target (a short line
// marks the target level reached); it is never shown as a stop loss.
// Daily scorecard per timeframe at the bottom. Nothing repaints: decisions use closed bars, higher timeframes
// are read from their last closed bar.
// Educational tool, not investment advice.

//@version=6
indicator("FOXREX · Wave Retracement Zones", shorttitle = "FOXREX Waves", overlay = true, max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500, max_bars_back = 500)

// ───────────────────────────── Inputs
string G0      = "Targets & stops"
string profile = input.string("Auto by timeframe", "Profile", options = ["Auto by timeframe", "Custom"], group = G0, tooltip = "Auto: 1m TP 1/2/3/5 stop ≤5 · 5m TP 2.5/5/10/15 stop ≤10 · 15m TP 2.5/5/10/20 stop ≤10 · 1H/4H TP 5/10/20/40 stop ≤15 · D+ TP 10/20/40/80 stop ≤25. Custom: the values below on every timeframe.", display = display.none)
float  tp1Pts  = input.float(2.5, "Custom TP1", minval = 0.1, step = 0.5, group = G0, inline = "t1", display = display.none)
float  tp2Pts  = input.float(5.0, "TP2", minval = 0.1, step = 0.5, group = G0, inline = "t1", display = display.none)
float  tp3Pts  = input.float(10.0, "Custom TP3", minval = 0.1, step = 0.5, group = G0, inline = "t2", display = display.none)
float  tp4Pts  = input.float(20.0, "TP4", minval = 0.1, step = 0.5, group = G0, inline = "t2", display = display.none)
float  slMinC  = input.float(3.0, "Custom stop min", minval = 0.1, step = 0.5, group = G0, inline = "s", display = display.none)
float  slMaxC  = input.float(10.0, "max", minval = 0.5, step = 0.5, group = G0, inline = "s", display = display.none)
float  lotVal  = input.float(0.0, "Simulation: $ per 1.0 move for 1 lot (0 = auto)", minval = 0.0, step = 1.0, group = G0, tooltip = "Auto: 100 for gold (1 lot = 100 oz), otherwise the symbol's point value. Every trade is simulated with 1 lot and no spread.", display = display.none)
float  comm    = input.float(6.0, "Simulation: commission per lot ($)", minval = 0.0, step = 0.5, group = G0, display = display.none)
float  slBuf   = input.float(0.1, "Stop buffer beyond the zone (× ATR)", minval = 0.0, step = 0.05, group = G0, display = display.none)
int    noProg  = input.int(15, "No-progress exit (bars without TP1, 0 = off)", minval = 0, group = G0, tooltip = "1m: 15 minutes · 5m: 75 minutes · 15m: under 4 hours", display = display.none)
int    maxBars = input.int(60, "Maximum trade life (bars)", minval = 5, group = G0, display = display.none)
string protect = input.string("Step: entry after TP1, then previous target", "Profit protection", options = ["Step: entry after TP1, then previous target", "Entry after TP1 only", "Off (keep the original stop)"], group = G0, display = display.none)
string acct    = input.string("Highest target reached", "Result points", options = ["Highest target reached", "25% closed at each target"], group = G0, display = display.none)

string G1      = "Structure & local zones"
int    swLen   = input.int(5, "Swing length (bars each side)", minval = 1, maxval = 50, group = G1, display = display.none)
bool   useWick = input.bool(false, "Break on wick (off = candle close)", group = G1, display = display.none)
string anchor  = input.string("First stall after the break", "Leg start (fib 0%)", options = ["First stall after the break", "Swing before the break"], group = G1, display = display.none)
float  fEntry  = input.float(0.5, "Zone start (retracement)", minval = 0.236, maxval = 0.886, step = 0.01, group = G1, display = display.none)
float  fZone   = input.float(0.618, "Zone end (retracement)", minval = 0.236, maxval = 0.95, step = 0.01, group = G1, display = display.none)
float  fInv    = input.float(0.786, "Invalidation (retracement)", minval = 0.5, maxval = 1.0, step = 0.01, group = G1, display = display.none)
float  minLeg  = input.float(1.5, "Minimum leg size (× ATR)", minval = 0.0, step = 0.1, group = G1, display = display.none)
int    maxWait = input.int(300, "Zone life (bars after the leg end)", minval = 5, group = G1, display = display.none)
string trig    = input.string("Middle limit or rejection", "Entry", options = ["Middle limit or rejection", "Limit at zone middle", "Rejection candle"], group = G1, display = display.none)
int    maxEnt  = input.int(2, "Max entries per zone", minval = 1, maxval = 10, group = G1, display = display.none)
int    reCool  = input.int(3, "Bars between entries in the same zone", minval = 1, group = G1, display = display.none)
bool   withTr  = input.bool(true, "Local zones: only with the local structure (last BOS)", group = G1, display = display.none)

string G6      = "Major timeframe (direction)"
bool   showMaj = input.bool(true, "Use a major timeframe", group = G6, display = display.none)
bool   majAuto = input.bool(true, "Auto (1m→15m, 5m→1H, 15m→4H, 1H→D)", group = G6, display = display.none)
string majTfIn = input.timeframe("15", "Major timeframe when not auto", group = G6, display = display.none)
string majFlt  = input.string("Off", "Direction filter", options = ["Major structure + active zone", "Active major zone only", "Off"], group = G6, tooltip = "Major structure: trades only in the direction of the major timeframe's last break of structure. Active zone: nothing against a major zone that price is reacting in.", display = display.none)
bool   tradeMj = input.bool(true, "Take trades at major zones", group = G6, display = display.none)
bool   showMjT = input.bool(true, "Show the major timeframe's open trade", group = G6, display = display.none)

string G7      = "Daily zones (all timeframes)"
bool   showDL  = input.bool(true, "Show daily buy / sell zones", group = G7, display = display.none)
bool   tradeDL = input.bool(true, "Take trades at daily zones (rejection)", group = G7, display = display.none)
int    dlN     = input.int(2, "Zones per side", minval = 1, maxval = 6, group = G7, display = display.none)
float  dlRange = input.float(3.0, "Search range (× daily ATR)", minval = 1.0, step = 0.5, group = G7, display = display.none)
float  dlMerge = input.float(0.12, "Merge distance (× daily ATR)", minval = 0.02, step = 0.02, group = G7, display = display.none)
float  dlMinW  = input.float(2.5, "Minimum strength to trade a daily zone", minval = 0.0, step = 0.5, group = G7, display = display.none)
bool   dlSwing = input.bool(true, "Include daily swing highs / lows", group = G7, display = display.none)
float  dlStep  = input.float(0.0, "Round-number step (0 = auto)", minval = 0.0, group = G7, display = display.none)
string dlAn    = input.string("", "Analyst levels (comma separated)", group = G7, display = display.none)
int    dlExt   = input.int(12, "Extend right (bars)", minval = 0, maxval = 200, group = G7, display = display.none)

string G5      = "Abnormal candle filter"
bool   useSpk  = input.bool(true, "Skip signals after an abnormal candle", group = G5, display = display.none)
float  spkK    = input.float(2.5, "Abnormal = range above (× ATR)", minval = 1.0, step = 0.1, group = G5, display = display.none)
int    spkLook = input.int(3, "Look back (bars)", minval = 1, maxval = 20, group = G5, display = display.none)

string G4      = "Display"
bool   showOld = input.bool(false, "Keep previous days (always on for D/W/M)", group = G4, display = display.none)
bool   showFin = input.bool(false, "Keep finished zones (faded)", group = G4, display = display.none)
bool   showLeg = input.bool(false, "Show the leg (fib 0% → 100%)", group = G4, display = display.none)
bool   showBos = input.bool(false, "Show BOS lines", group = G4, display = display.none)
int    keepN   = input.int(40, "Finished trade labels kept", minval = 1, maxval = 200, group = G4, display = display.none)
bool   showTb  = input.bool(true, "Dashboard", group = G4, display = display.none)
string tbPos   = input.string("Top right", "Dashboard position", options = ["Top right", "Top left", "Bottom right", "Bottom left"], group = G4, display = display.none)
bool   showSt  = input.bool(true, "Daily scorecard", group = G4, display = display.none)
string stPos   = input.string("Bottom right", "Scorecard position", options = ["Top right", "Top left", "Bottom right", "Bottom left"], group = G4, display = display.none)
color  cSell   = input.color(#FF5C7A, "Sell", group = G4, inline = "c", display = display.none)
color  cBuy    = input.color(#00D4A7, "Buy", group = G4, inline = "c", display = display.none)
color  cZone   = input.color(#9CA3AF, "Zones", group = G4, inline = "c", display = display.none)

// ───────────────────────────── Types
type Zone
    int   dir
    float p0
    int   b0
    float p1
    int   b1
    int   state
    bool  touched
    int   entries
    int   lastE
    int   dKey
    box   bx
    line  mid
    line  lg
    int   bB
    int   sSt
    float sLo
    int   sLoB
    float sHi
    bool  armed
    int   t1
    int   tB

type MajView
    box   bx
    line  mid
    int   id
    bool  tch
    int   entries
    int   lastE
    bool  armed

type Trade
    int          dir
    float        entry
    float        sl
    array<float> tps
    int          hits
    int          eB
    int          dKey
    float        net
    float        rem
    int          state
    string       src
    label        lb
    array<line>  ln
    array<label> rl
    Zone         zn
    MajView      mv
    box          sb
    box          pb
    line         tl

// ───────────────────────────── Helpers
int tfSecs = timeframe.in_seconds()
string tkU = str.upper(syminfo.ticker)
float lotV = lotVal > 0 ? lotVal : (str.contains(tkU, "XAU") or str.contains(tkU, "GOLD")) ? 100.0 : nz(syminfo.pointvalue, 1.0)

fmtP(float v) =>
    v >= 10000 ? str.tostring(v, "#,##0") : v >= 100 ? str.tostring(v, "#,##0.00") : str.tostring(v, format.mintick)

sgnPts(float v) =>
    (v > 0 ? "+" : v < 0 ? "−" : "") + str.tostring(math.abs(v), "#.##")

usd(float v) =>
    (v > 0 ? "+$" : v < 0 ? "−$" : "$") + str.tostring(math.abs(v), "#,##0")

tfLabel(int s) =>
    s < 60 ? str.tostring(s) + "s" : s < 3600 ? "M" + str.tostring(math.round(s / 60)) : s < 86400 ? "H" + str.tostring(math.round(s / 3600)) : s < 604800 ? "D" + str.tostring(math.round(s / 86400)) : "W"

// Targets / stop range for a timeframe (seconds).
pTp(int s, int i) =>
    float r = na
    if profile == "Custom"
        r := i == 0 ? tp1Pts : i == 1 ? tp2Pts : i == 2 ? tp3Pts : tp4Pts
    else if s <= 60
        r := i == 0 ? 1.0 : i == 1 ? 2.0 : i == 2 ? 3.0 : 5.0
    else if s <= 300
        r := i == 0 ? 2.5 : i == 1 ? 5.0 : i == 2 ? 10.0 : 15.0
    else if s <= 1800
        r := i == 0 ? 2.5 : i == 1 ? 5.0 : i == 2 ? 10.0 : 20.0
    else if s < 86400
        r := i == 0 ? 5.0 : i == 1 ? 10.0 : i == 2 ? 20.0 : 40.0
    else
        r := i == 0 ? 10.0 : i == 1 ? 20.0 : i == 2 ? 40.0 : 80.0
    r

pSlMin(int s) =>
    profile == "Custom" ? slMinC : s <= 60 ? 1.5 : s <= 300 ? 3.0 : s <= 1800 ? 4.0 : s < 86400 ? 5.0 : 10.0

pSlMax(int s) =>
    profile == "Custom" ? slMaxC : s <= 60 ? 5.0 : s < 3600 ? 10.0 : s < 86400 ? 15.0 : 25.0

// Stop distance: structure, clamped to the timeframe's range (important = major / daily zone trade).
clampSl(float d, int s, bool imp) =>
    float lo = pSlMin(imp ? math.max(s, 300) : s)
    float hi = pSlMax(s)
    math.min(math.max(d, lo), hi)

tpArr(float ep, int dir, int s, bool imp) =>
    int ps = imp ? math.max(s, 300) : s
    array.from(ep + dir * pTp(ps, 0), ep + dir * pTp(ps, 1), ep + dir * pTp(ps, 2), ep + dir * pTp(ps, 3))

// Stop after profit protection, for a trade that has reached `hits` targets.
protSl(int dir, float en, float sl, int hits, array<float> tps) =>
    float r = sl
    if protect != "Off (keep the original stop)" and hits >= 1
        float ns = protect == "Step: entry after TP1, then previous target" and hits >= 2 ? tps.get(hits - 2) : en
        if dir * (ns - r) > 0
            r := ns
    r

isRej(int dir) =>
    float rg = high - low
    dir > 0 ? (close > open or math.min(open, close) - low >= 0.4 * rg) : (close < open or high - math.max(open, close) >= 0.4 * rg)

lvl(Zone z, float r) =>
    z.p1 + r * (z.p0 - z.p1)

// Highest high (dir = -1) or lowest low (dir = +1) since bar fromB: the swing that started the move.
legStart(int dir, int fromB) =>
    int   n     = na(fromB) ? 50 : math.min(math.max(bar_index - fromB, 1), 450)
    float best  = dir < 0 ? high : low
    int   bestB = bar_index
    for i = 0 to n
        float v = dir < 0 ? high[i] : low[i]
        if (dir < 0 and v > best) or (dir > 0 and v < best)
            best  := v
            bestB := bar_index - i
    [best, bestB]

newZone(int dir, float p0, int b0, int k) =>
    Zone.new(dir, p0, b0, dir < 0 ? low : high, bar_index, 0, false, 0, na, k, na, na, na, bar_index, anchor == "Swing before the break" ? 3 : 0, na, na, na, true, time, time)

// Leg update while the zone is forming: first stall after the break → fib 0%, new extremes → fib 100%.
legUpdate(Zone z) =>
    if z.state == 0 and z.sSt < 2 and barstate.isconfirmed and bar_index > z.bB
        bool ext = z.dir > 0 ? high > z.p1 : low < z.p1
        if z.sSt == 0
            if not ext
                z.sSt  := 1
                z.sHi  := z.p1
                z.sLo  := z.dir > 0 ? low : high
                z.sLoB := bar_index
        else
            if z.dir > 0 ? low < z.sLo : high > z.sLo
                z.sLo  := z.dir > 0 ? low : high
                z.sLoB := bar_index
            if z.dir > 0 ? close > z.sHi : close < z.sHi
                if z.dir > 0 ? z.sLo > z.p0 : z.sLo < z.p0
                    z.p0 := z.sLo
                    z.b0 := z.sLoB
                z.sSt := 2
    if z.state == 0 and bar_index > z.b1 and (z.dir < 0 ? low < z.p1 : high > z.p1)
        z.p1 := z.dir < 0 ? low : high
        z.b1 := bar_index
        z.t1 := time
    true

// Zone touch / invalidation / entry decision on a closed bar.
// Returns [fire, entry, stop, stop points, stopped on the fill candle].
zoneEval(Zone z, float a, bool sBlk, int tr, bool blocked, int s) =>
    bool  fire = false
    bool  sbSl = false
    float ep   = na
    float sl   = na
    float dist = na
    if z.state <= 1
        float zA    = lvl(z, fEntry)
        float zB    = lvl(z, fZone)
        float zI    = lvl(z, fInv)
        float zM    = (zA + zB) / 2
        bool  valid = math.abs(z.p0 - z.p1) >= minLeg * a
        if valid and bar_index > z.b1 and barstate.isconfirmed
            bool inZone  = z.dir < 0 ? high >= zA : low <= zA
            bool hitMid  = z.dir < 0 ? high >= zM : low <= zM
            bool invalid = z.dir < 0 ? close > zI : close < zI
            bool rej     = (z.dir < 0 ? close < zB : close > zB) and isRej(z.dir)
            if not z.armed and (z.dir < 0 ? low <= zM - pTp(s, 0) : high >= zM + pTp(s, 0))
                z.armed := true
            if inZone and not z.touched
                z.touched := true
                z.state   := 1
            bool byLim = trig != "Rejection candle" and hitMid
            bool byRej = not byLim and trig != "Limit at zone middle" and inZone and rej and not invalid
            if (byLim or byRej) and z.armed and not blocked and not sBlk and (not withTr or z.dir == tr) and z.entries < maxEnt and (na(z.lastE) or bar_index - z.lastE >= reCool)
                fire := true
                ep   := byLim ? (z.dir < 0 ? math.max(zM, open) : math.min(zM, open)) : close
                float zSl = z.dir < 0 ? (byLim ? zI : math.max(zI, high)) + slBuf * a : (byLim ? zI : math.min(zI, low)) - slBuf * a
                dist := clampSl(math.abs(ep - zSl), s, false)
                sl   := ep - z.dir * dist
                sbSl := byLim and (z.dir < 0 ? high >= sl : low <= sl)
                z.entries += 1
                z.lastE   := bar_index
            if invalid
                z.state := 13
        if z.state <= 1 and bar_index - z.b1 > maxWait
            z.state := 14
    [fire, ep, sl, dist, sbSl]

// ───────────────────────────── Major timeframe engine (evaluated on the major timeframe through request.security)
majorEngine() =>
    int   s  = timeframe.in_seconds()
    float a  = ta.atr(14)
    float hh = ta.pivothigh(high, swLen, swLen)
    float ll = ta.pivotlow(low, swLen, swLen)
    var float hP   = na
    var int   hB   = na
    var bool  hU   = true
    var float lP   = na
    var int   lB   = na
    var bool  lU   = true
    var int   tr   = 0
    var Zone  zS   = na
    var Zone  zBy  = na
    var int   tDir = 0
    var float tEn  = na
    var float tSl  = na
    var int   tHit = 0
    var int   tEB  = na
    var int   tT   = na
    var Zone  tZ   = na
    var array<float> tTp = array.new<float>(5, 0.0)
    if not na(hh)
        hP := hh
        hB := bar_index - swLen
        hU := false
    if not na(ll)
        lP := ll
        lB := bar_index - swLen
        lU := false
    bool  dn   = barstate.isconfirmed and not lU and not na(lP) and (useWick ? low : close) < lP
    bool  up   = barstate.isconfirmed and not hU and not na(hP) and (useWick ? high : close) > hP
    float aP   = nz(a[1], a)
    int   sAgo = ta.barssince((high - low) > spkK * aP)
    bool  sBlk = useSpk and not na(sAgo) and sAgo < spkLook
    if dn
        lU := true
        tr := -1
        if na(zS) or zS.state != 0
            [p0, b0] = legStart(-1, hB)
            zS := newZone(-1, p0, b0, 0)
    if up
        hU := true
        tr := 1
        if na(zBy) or zBy.state != 0
            [p0, b0] = legStart(1, lB)
            zBy := newZone(1, p0, b0, 0)
    // open major trade → outcome
    if tDir != 0 and barstate.isconfirmed and bar_index > tEB
        if tDir < 0 ? high >= tSl : low <= tSl
            if tHit == 0
                tZ.entries := maxEnt
            tZ.armed := false
            tDir     := 0
        else
            while tHit < 4 and (tDir < 0 ? low <= tTp.get(tHit) : high >= tTp.get(tHit))
                tHit += 1
            tSl := protSl(tDir, tEn, tSl, tHit, tTp)
            if tHit == 4 or bar_index - tEB >= maxBars or (noProg > 0 and tHit == 0 and bar_index - tEB >= noProg)
                tZ.armed := false
                tDir     := 0
    // zones → entries
    if not na(zS)
        legUpdate(zS)
        [f, ep, sl, d, sb] = zoneEval(zS, a, sBlk, tr, tDir != 0, s)
        if f and not sb
            tDir := -1
            tEn  := ep
            tSl  := sl
            tHit := 0
            tEB  := bar_index
            tT   := time
            tZ   := zS
            tTp  := tpArr(ep, -1, s, false)
        else if f and sb
            zS.entries := maxEnt
            zS.armed   := false
    if not na(zBy)
        legUpdate(zBy)
        [f, ep, sl, d, sb] = zoneEval(zBy, a, sBlk, tr, tDir != 0, s)
        if f and not sb
            tDir := 1
            tEn  := ep
            tSl  := sl
            tHit := 0
            tEB  := bar_index
            tT   := time
            tZ   := zBy
            tTp  := tpArr(ep, 1, s, false)
        else if f and sb
            zBy.entries := maxEnt
            zBy.armed   := false
    bool sV = not na(zS) and math.abs(zS.p0 - zS.p1) >= minLeg * a
    bool bV = not na(zBy) and math.abs(zBy.p0 - zBy.p1) >= minLeg * a
    [sV ? zS.p0 : na, sV ? zS.p1 : na, sV ? zS.t1 : na, sV ? zS.state : -1, sV ? zS.tB : na, bV ? zBy.p0 : na, bV ? zBy.p1 : na, bV ? zBy.t1 : na, bV ? zBy.state : -1, bV ? zBy.tB : na, tr, tDir, tEn, tSl, tHit, tT, tTp.get(0), tTp.get(3)]

// Values of the last closed major bar (no repainting).
majorPack() =>
    [a1, a2, a3, a4, a5, b1, b2, b3, b4, b5, c1, d1, d2, d3, d4, d5, d6, d7] = majorEngine()
    [a1[1], a2[1], a3[1], a4[1], a5[1], b1[1], b2[1], b3[1], b4[1], b5[1], c1[1], d1[1], d2[1], d3[1], d4[1], d5[1], d6[1], d7[1]]

string majAutoTf = tfSecs <= 60 ? "15" : tfSecs <= 300 ? "60" : tfSecs <= 900 ? "240" : tfSecs <= 3600 ? "D" : "W"
string majTf     = majAuto ? majAutoTf : majTfIn
bool   majOn     = showMaj and tfSecs < timeframe.in_seconds(majTf)
string mTf       = majOn ? majTf : timeframe.period
[mSP0, mSP1, mST1, mSSt, mSId, mBP0, mBP1, mBT1, mBSt, mBId, mTr, mTDir, mTEn, mTSl, mTHit, mTT, mTTp1, mTTp4] = request.security(syminfo.tickerid, mTf, majorPack(), lookahead = barmerge.lookahead_on)
string mLbl = tfLabel(timeframe.in_seconds(majTf))
string cLbl = tfLabel(tfSecs)

// ───────────────────────────── Daily data (previous completed sessions → no repaint)
dailyPack() =>
    float dph = ta.pivothigh(high, 2, 2)
    float dpl = ta.pivotlow(low, 2, 2)
    bool  hPh = not na(dph)
    bool  hPl = not na(dpl)
    [high[1], low[1], close[1], ta.highest(high, 20)[1], ta.lowest(low, 20)[1], ta.ema(close, 20)[1], ta.ema(close, 50)[1], ta.atr(14)[1], ta.valuewhen(hPh, dph, 0)[1], ta.valuewhen(hPh, dph, 1)[1], ta.valuewhen(hPh, dph, 2)[1], ta.valuewhen(hPh, dph, 3)[1], ta.valuewhen(hPl, dpl, 0)[1], ta.valuewhen(hPl, dpl, 1)[1], ta.valuewhen(hPl, dpl, 2)[1], ta.valuewhen(hPl, dpl, 3)[1]]

[dH, dL, dC, d20H, d20L, dE20, dE50, dAtr, sh0, sh1, sh2, sh3, sl0, sl1, sl2, sl3] = request.security(syminfo.tickerid, "D", dailyPack(), lookahead = barmerge.lookahead_on)
[wH, wL] = request.security(syminfo.tickerid, "W", [high[1], low[1]], lookahead = barmerge.lookahead_on)

rngTxt(float lo, float hi) =>
    hi - lo < syminfo.mintick * 2 ? fmtP(hi) : fmtP(lo) + "–" + fmtP(hi)

addLv(array<float> lp, array<float> lw, array<string> ln, float p, float w, string n, float px, float lim) =>
    bool ok = not na(p) and not na(lim) and math.abs(p - px) <= lim
    if ok
        lp.push(p)
        lw.push(w)
        ln.push(n)
    ok

// Today's daily zones around price px: [low, high, strength, names], sorted from low to high.
buildDaily(float px) =>
    array<float>  zLo = array.new<float>()
    array<float>  zHi = array.new<float>()
    array<float>  zW  = array.new<float>()
    array<string> zN  = array.new<string>()
    if not na(dAtr) and not na(dH)
        float pvP = (dH + dL + dC) / 3
        float lim = dlRange * dAtr
        array<float>  lp = array.new<float>()
        array<float>  lw = array.new<float>()
        array<string> ln = array.new<string>()
        addLv(lp, lw, ln, dH, 3.0, "Prior-day high", px, lim)
        addLv(lp, lw, ln, dL, 3.0, "Prior-day low", px, lim)
        addLv(lp, lw, ln, dC, 1.0, "Prior-day close", px, lim)
        addLv(lp, lw, ln, pvP, 1.5, "Daily pivot", px, lim)
        addLv(lp, lw, ln, 2 * pvP - dL, 1.5, "Pivot R1", px, lim)
        addLv(lp, lw, ln, 2 * pvP - dH, 1.5, "Pivot S1", px, lim)
        addLv(lp, lw, ln, pvP + (dH - dL), 1.0, "Pivot R2", px, lim)
        addLv(lp, lw, ln, pvP - (dH - dL), 1.0, "Pivot S2", px, lim)
        addLv(lp, lw, ln, wH, 2.5, "Prior-week high", px, lim)
        addLv(lp, lw, ln, wL, 2.5, "Prior-week low", px, lim)
        addLv(lp, lw, ln, d20H, 2.0, "20-day high", px, lim)
        addLv(lp, lw, ln, d20L, 2.0, "20-day low", px, lim)
        addLv(lp, lw, ln, dE20, 1.0, "20-day EMA", px, lim)
        addLv(lp, lw, ln, dE50, 1.0, "50-day EMA", px, lim)
        if dlSwing
            for v in array.from(sh0, sh1, sh2, sh3)
                addLv(lp, lw, ln, v, 1.5, "Daily swing high", px, lim)
            for v in array.from(sl0, sl1, sl2, sl3)
                addLv(lp, lw, ln, v, 1.5, "Daily swing low", px, lim)
        float step  = dlStep > 0 ? dlStep : math.pow(10, math.floor(math.log10(px))) / 20
        float lo1   = math.floor(px / step) * step
        float step2 = step * 2
        float lo2   = math.floor(px / step2) * step2
        addLv(lp, lw, ln, lo1, 0.5, "Round number", px, lim)
        addLv(lp, lw, ln, lo1 + step, 0.5, "Round number", px, lim)
        addLv(lp, lw, ln, lo2, 1.0, "Round number", px, lim)
        addLv(lp, lw, ln, lo2 + step2, 1.0, "Round number", px, lim)
        if str.length(dlAn) > 0
            for sx in str.split(dlAn, ",")
                addLv(lp, lw, ln, str.tonumber(str.replace_all(sx, " ", "")), 2.5, "Analyst level", px, lim)
        float tol = math.max(dAtr * dlMerge, px * 0.0012)
        if lp.size() > 0
            array<int> ord = lp.sort_indices(order.ascending)
            for i in ord
                float  p = lp.get(i)
                float  w = lw.get(i)
                string n = ln.get(i)
                int    k = zLo.size()
                if k > 0 and p - zHi.get(k - 1) <= tol
                    zHi.set(k - 1, p)
                    zW.set(k - 1, zW.get(k - 1) + w)
                    if not str.contains(zN.get(k - 1), n)
                        zN.set(k - 1, zN.get(k - 1) + "\n" + n)
                else
                    zLo.push(p)
                    zHi.push(p)
                    zW.push(w)
                    zN.push(n)
        // give single-price levels a small band
        float pad = tol * 0.25
        for i = 0 to zLo.size() - 1
            if zLo.size() > 0
                zLo.set(i, zLo.get(i) - pad)
                zHi.set(i, zHi.get(i) + pad)
    [zLo, zHi, zW, zN]

// ───────────────────────────── Swings, structure, filters, day keys
float atr = ta.atr(14)
float ph  = ta.pivothigh(high, swLen, swLen)
float pl  = ta.pivotlow(low, swLen, swLen)

var float shP     = na
var int   shB     = na
var bool  shUsed  = true
var float slP     = na
var int   slB     = na
var bool  slUsed  = true
var int   trend   = 0
var float lastBos = na

if not na(ph)
    shP    := ph
    shB    := bar_index - swLen
    shUsed := false
if not na(pl)
    slP    := pl
    slB    := bar_index - swLen
    slUsed := false

bool bosDn = barstate.isconfirmed and not slUsed and not na(slP) and (useWick ? low : close) < slP
bool bosUp = barstate.isconfirmed and not shUsed and not na(shP) and (useWick ? high : close) > shP

float atrPrev  = nz(atr[1], atr)
int   spkAgo   = ta.barssince((high - low) > spkK * atrPrev)
bool  spkBlock = useSpk and not na(spkAgo) and spkAgo < spkLook

int  dKey    = year(time_tradingday) * 10000 + month(time_tradingday) * 100 + dayofmonth(time_tradingday)
bool keepAll = showOld or timeframe.isdwm
var int dToday = na
var int dYest  = na
var array<float> stT = array.new<float>(5, 0.0)
var array<float> stY = array.new<float>(5, 0.0)
var array<float> stA = array.new<float>(5, 0.0)

var array<Zone>  zLive  = array.new<Zone>()
var array<Zone>  zArch  = array.new<Zone>()
var array<Trade> tLive  = array.new<Trade>()
var array<Trade> tArch  = array.new<Trade>()
var array<line>  bosLn  = array.new<line>()

// today's daily zones (fixed at the first bar of the day) and how many times each was traded per side
var array<float>  dZLo = array.new<float>()
var array<float>  dZHi = array.new<float>()
var array<float>  dZW  = array.new<float>()
var array<string> dZN  = array.new<string>()
var array<int>    dZB  = array.new<int>()
var array<int>    dZS  = array.new<int>()

bool newDay = na(dToday) or dKey != dToday
if newDay
    if not na(dToday)
        stY   := stT.copy()
        dYest := dToday
    stT    := array.new<float>(5, 0.0)
    dToday := dKey
    [a, b, c, d] = buildDaily(open)
    dZLo := a
    dZHi := b
    dZW  := c
    dZN  := d
    dZB  := array.new<int>(a.size(), 0)
    dZS  := array.new<int>(a.size(), 0)
    if not keepAll
        for z in zArch
            box.delete(z.bx)
            line.delete(z.mid)
            line.delete(z.lg)
        zArch.clear()
        for t in tArch
            label.delete(t.lb)
            line.delete(t.tl)
        tArch.clear()
        for l in bosLn
            l.delete()
        bosLn.clear()

bump(array<float> a, int i, float v) =>
    a.set(i, a.get(i) + v)
    true

score(int key, int i, float v) =>
    bump(stA, i, v)
    if key == dToday
        bump(stT, i, v)
    else if key == dYest
        bump(stY, i, v)
    true

zoneGone(Zone z) =>
    if showFin and not na(z.bx)
        z.bx.set_right(bar_index)
        z.bx.set_bgcolor(color.new(cZone, 95))
        z.bx.set_border_color(color.new(z.dir < 0 ? cSell : cBuy, 80))
        z.bx.set_text("")
        line.delete(z.mid)
        line.delete(z.lg)
    else
        box.delete(z.bx)
        line.delete(z.mid)
        line.delete(z.lg)
        z.bx := na
    true

// Close a trade: result points, scorecard, remove its lines, keep one small label with side and points.
closeTrade(Trade t, string res) =>
    t.state := 10
    if acct == "Highest target reached"
        t.net := t.hits > 0 ? math.abs(t.tps.get(t.hits - 1) - t.entry) : t.net
    float pnl = t.net * lotV - comm
    score(t.dKey, 3, t.net)
    score(t.dKey, 4, pnl)
    for l in t.ln
        l.delete()
    t.ln.clear()
    for l in t.rl
        l.delete()
    t.rl.clear()
    box.delete(t.sb)
    box.delete(t.pb)
    bool won = t.hits > 0
    string side = t.dir < 0 ? "SELL" : "BUY"
    color  cw   = t.dir < 0 ? #E0475F : #00A884
    if won
        float tp = t.tps.get(t.hits - 1)
        t.tl := line.new(t.eB, tp, math.max(bar_index, t.eB + 3), tp, color = cw, width = 2)
    t.lb.set_text(side + " " + res + " " + sgnPts(t.net))
    t.lb.set_size(size.tiny)
    t.lb.set_color(won ? color.new(cw, 15) : color.new(#6B7280, 30))
    t.lb.set_textcolor(won ? color.white : color.new(color.white, 20))
    t.lb.set_tooltip(cLbl + " " + side + " · " + t.src + "\nEntry " + fmtP(t.entry) + "\nResult " + res + " · " + sgnPts(t.net) + " pts\n1 lot: " + usd(pnl) + " (commission $" + str.tostring(comm, "#.##") + ")")
    if not na(t.zn)
        t.zn.armed := false
    if not na(t.mv)
        t.mv.armed := false
    true

// Open a trade on this chart (drawings on the right edge, so the open trade is always visible).
openTrade(int dir, float ep, float sl, float dist, bool imp, string src, Zone zn, MajView mv) =>
    array<float> tps = tpArr(ep, dir, tfSecs, imp)
    string side = dir < 0 ? "SELL" : "BUY"
    label lb = label.new(bar_index, dir < 0 ? high : low, side, style = dir < 0 ? label.style_label_down : label.style_label_up, color = dir < 0 ? #E0475F : #00A884, textcolor = color.white, size = size.small, tooltip = cLbl + " " + side + " · " + src + " @ " + fmtP(ep) + "\nSL " + fmtP(sl) + " (" + str.tostring(dist, "#.##") + " pts)\nTP " + fmtP(tps.get(0)) + " / " + fmtP(tps.get(1)) + " / " + fmtP(tps.get(2)) + " / " + fmtP(tps.get(3)))
    array<line>  ln = array.new<line>()
    array<label> rl = array.new<label>()
    ln.push(line.new(bar_index, sl, bar_index + 6, sl, color = color.new(cSell, 10), style = line.style_dashed))
    rl.push(label.new(bar_index + 6, sl, "SL " + fmtP(sl), style = label.style_label_left, color = color.new(color.black, 100), textcolor = cSell, size = size.tiny))
    for i = 0 to 3
        float p = tps.get(i)
        ln.push(line.new(bar_index, p, bar_index + 6, p, color = color.new(cBuy, 40), style = line.style_dotted))
        rl.push(label.new(bar_index + 6, p, "TP" + str.tostring(i + 1) + " " + fmtP(p), style = label.style_label_left, color = color.new(color.black, 100), textcolor = color.new(cBuy, 20), size = size.tiny))
    ln.push(line.new(bar_index, ep, bar_index + 6, ep, color = color.new(color.white, 20), width = 2))
    rl.push(label.new(bar_index + 6, ep, "▶ " + cLbl + " " + side + " " + fmtP(ep) + " · open", style = label.style_label_left, color = color.new(dir < 0 ? #E0475F : #00A884, 10), textcolor = color.white, size = size.small))
    box sb = box.new(bar_index, math.max(ep, sl), bar_index + 6, math.min(ep, sl), border_color = color.new(cSell, 100), bgcolor = color.new(cSell, 82))
    box pb = box.new(bar_index, math.max(ep, tps.get(3)), bar_index + 6, math.min(ep, tps.get(3)), border_color = color.new(cBuy, 100), bgcolor = color.new(cBuy, 86))
    Trade.new(dir, ep, sl, tps, 0, bar_index, dKey, 0.0, 1.0, 1, src, lb, ln, rl, zn, mv, sb, pb, na)

// ───────────────────────────── Major zones on this chart (only live ones, one per side)
var MajView mvS = MajView.new(na, na, na, false, 0, na, true)
var MajView mvB = MajView.new(na, na, na, false, 0, na, true)

mzDraw(MajView v, int dir, float p0, float p1, int t1, int st, int id) =>
    bool live = majOn and not na(id) and st >= 0 and st <= 1
    if live
        float zA  = p1 + fEntry * (p0 - p1)
        float zB  = p1 + fZone * (p0 - p1)
        float zM  = (zA + zB) / 2
        float top = math.max(zA, zB)
        float bot = math.min(zA, zB)
        color c   = dir < 0 ? cSell : cBuy
        int   rx  = time + 4 * tfSecs * 1000
        if na(v.id) or v.id != id
            box.delete(v.bx)
            line.delete(v.mid)
            v.id      := id
            v.tch     := false
            v.entries := 0
            v.lastE   := na
            v.armed   := true
            v.bx  := box.new(t1, top, rx, bot, xloc = xloc.bar_time, border_color = color.new(c, 20), border_width = 1, bgcolor = color.new(c, 88), text = mLbl + (dir < 0 ? " SELL ZONE · MAJOR" : " BUY ZONE · MAJOR"), text_size = size.tiny, text_color = c, text_halign = text.align_left, text_valign = dir < 0 ? text.align_top : text.align_bottom)
            v.mid := line.new(t1, zM, rx, zM, xloc = xloc.bar_time, color = color.new(c, 50), style = line.style_dotted)
        v.bx.set_lefttop(t1, top)
        v.bx.set_rightbottom(rx, bot)
        v.mid.set_xy1(t1, zM)
        v.mid.set_xy2(rx, zM)
        if dir > 0 ? low <= zA : high >= zA
            v.tch := true
    else if not na(v.bx)
        box.delete(v.bx)
        line.delete(v.mid)
        v.bx  := na
        v.mid := na
    live

bool mSLive = mzDraw(mvS, -1, mSP0, mSP1, mST1, mSSt, mSId)
bool mBLive = mzDraw(mvB, 1, mBP0, mBP1, mBT1, mBSt, mBId)

// A major zone is "active" while price reacts inside it: touched, not invalidated, leg extreme not yet broken.
bool majSellAct = mSLive and (mSSt == 1 or mvS.tch) and close < mSP1 + fInv * (mSP0 - mSP1) and close > mSP1
bool majBuyAct  = mBLive and (mBSt == 1 or mvB.tch) and close > mBP1 + fInv * (mBP0 - mBP1) and close < mBP1
bool strF       = majFlt == "Major structure + active zone" and majOn and mTr != 0
bool okBuy      = not (majFlt != "Off" and majSellAct) and not (strF and mTr < 0)
bool okSell     = not (majFlt != "Off" and majBuyAct) and not (strF and mTr > 0)

// Major open trade: one entry line and one label on the right edge, only while it is open
var line  mTln = na
var label mTlb = na
var int   mTid = na
if majOn and showMjT and mTDir != 0 and not na(mTT)
    color c = mTDir < 0 ? cSell : cBuy
    if na(mTid) or mTid != mTT
        line.delete(mTln)
        label.delete(mTlb)
        mTid := mTT
        mTln := line.new(mTT, mTEn, time, mTEn, xloc = xloc.bar_time, color = color.new(c, 30), style = line.style_dashed, width = 1)
        mTlb := label.new(time, mTEn, "", xloc = xloc.bar_time, style = label.style_label_left, color = color.new(c, 75), textcolor = color.white, size = size.tiny)
    int rx = time + 10 * tfSecs * 1000
    mTln.set_x2(rx)
    mTlb.set_x(rx)
    mTlb.set_text(mLbl + (mTDir < 0 ? " SELL " : " BUY ") + fmtP(mTEn) + (mTHit > 0 ? " ✓TP" + str.tostring(mTHit) : "") + " · open")
    mTlb.set_tooltip("Major " + mLbl + " trade (shown while open)\nSL " + fmtP(mTSl) + "\nTP1 " + fmtP(mTTp1) + " … TP4 " + fmtP(mTTp4))
else if not na(mTid)
    line.delete(mTln)
    label.delete(mTlb)
    mTid := na

// ───────────────────────────── Local structure → zones (at most two live zones per side)
addZone(int dir, float p0, int b0) =>
    int n = 0
    for z in zLive
        if z.dir == dir and z.state <= 1
            n += 1
    if n >= 2
        for z in zLive
            if z.dir == dir and z.state <= 1 and n >= 2
                z.state := 15
                n -= 1
    zLive.push(newZone(dir, p0, b0, dKey))
    true

if bosDn
    slUsed  := true
    trend   := -1
    lastBos := slP
    if showBos
        bosLn.push(line.new(slB, slP, bar_index, slP, color = color.new(cSell, 60), style = line.style_dotted))
    bool forming = false
    for z in zLive
        if z.dir < 0 and z.state == 0
            forming := true
    if not forming
        [p0, b0] = legStart(-1, shB)
        addZone(-1, p0, b0)

if bosUp
    shUsed  := true
    trend   := 1
    lastBos := shP
    if showBos
        bosLn.push(line.new(shB, shP, bar_index, shP, color = color.new(cBuy, 60), style = line.style_dotted))
    bool forming = false
    for z in zLive
        if z.dir > 0 and z.state == 0
            forming := true
    if not forming
        [p0, b0] = legStart(1, slB)
        addZone(1, p0, b0)

var string lastTrade    = "—"
var int    lastTradeDir = 0

// ───────────────────────────── Open trade → outcome (before new entries, so a trade that closes on this bar frees the slot)
for t in tLive
    if t.state == 1
        for l in t.ln
            l.set_x2(bar_index + 6)
        for l in t.rl
            l.set_x(bar_index + 6)
        t.sb.set_right(bar_index + 6)
        t.pb.set_right(bar_index + 6)
        if barstate.isconfirmed and bar_index > t.eB
            bool   done = false
            string res  = ""
            bool   hitSl = t.dir < 0 ? high >= t.sl : low <= t.sl
            if hitSl
                t.net += t.rem * t.dir * (t.sl - t.entry)
                t.rem := 0.0
                done  := true
                res   := t.hits == 0 ? "SL" : "TP" + str.tostring(t.hits)
                if t.hits == 0
                    score(t.dKey, 2, 1)
                    if not na(t.zn)
                        t.zn.entries := maxEnt
                    if not na(t.mv)
                        t.mv.entries := maxEnt
            else
                int before = t.hits
                while t.hits < 4 and (t.dir < 0 ? low <= t.tps.get(t.hits) : high >= t.tps.get(t.hits))
                    t.net += 0.25 * math.abs(t.tps.get(t.hits) - t.entry)
                    t.rem -= 0.25
                    t.hits += 1
                if t.hits > before
                    if before == 0
                        score(t.dKey, 1, 1)
                    t.sl := protSl(t.dir, t.entry, t.sl, t.hits, t.tps)
                    t.ln.get(0).set_y1(t.sl)
                    t.ln.get(0).set_y2(t.sl)
                    t.rl.get(0).set_y(t.sl)
                    t.rl.get(0).set_text("SL " + fmtP(t.sl))
                    t.sb.set_top(math.max(t.entry, t.sl))
                    t.sb.set_bottom(math.min(t.entry, t.sl))
                    t.rl.get(5).set_text("▶ " + cLbl + (t.dir < 0 ? " SELL " : " BUY ") + fmtP(t.entry) + " · ✓TP" + str.tostring(t.hits))
                bool stale = noProg > 0 and t.hits == 0 and bar_index - t.eB >= noProg
                if t.hits == 4
                    done := true
                    res  := "TP4"
                else if stale or bar_index - t.eB >= maxBars
                    t.net += t.rem * t.dir * (close - t.entry)
                    t.rem := 0.0
                    done  := true
                    res   := t.hits > 0 ? "TP" + str.tostring(t.hits) : "⌛"
                    if t.hits == 0 and t.net < 0
                        score(t.dKey, 2, 1)
            if done
                closeTrade(t, res)
                lastTrade    := (t.dir < 0 ? "SELL " : "BUY ") + fmtP(t.entry) + " → " + res + " " + sgnPts(t.net) + " · " + usd(t.net * lotV - comm)
                lastTradeDir := t.dir

bool busy = false
for t in tLive
    if t.state == 1
        busy := true

bool evSell = false
bool evBuy  = false

// ───────────────────────────── Entries 1 · major zones (seen on this chart)
majEntry(MajView v, int dir, float p0, float p1, bool live) =>
    bool  fire = false
    float ep   = na
    float sl   = na
    float dist = na
    bool  sbSl = false
    if live and tradeMj and barstate.isconfirmed and v.entries < maxEnt
        float zA = p1 + fEntry * (p0 - p1)
        float zB = p1 + fZone * (p0 - p1)
        float zI = p1 + fInv * (p0 - p1)
        float zM = (zA + zB) / 2
        if not v.armed and (dir < 0 ? low <= zM - pTp(math.max(tfSecs, 300), 0) : high >= zM + pTp(math.max(tfSecs, 300), 0))
            v.armed := true
        bool inZone  = dir < 0 ? high >= zA : low <= zA
        bool hitMid  = dir < 0 ? high >= zM : low <= zM
        bool invalid = dir < 0 ? close > zI : close < zI
        bool byLim   = trig != "Rejection candle" and hitMid
        bool byRej   = not byLim and trig != "Limit at zone middle" and inZone and (dir < 0 ? close < zB : close > zB) and isRej(dir)
        if invalid
            v.entries := maxEnt
        else if (byLim or byRej) and v.armed and (na(v.lastE) or bar_index - v.lastE >= reCool)
            fire := true
            ep   := byLim ? (dir < 0 ? math.max(zM, open) : math.min(zM, open)) : close
            dist := clampSl(math.abs(ep - (zI - dir * slBuf * atr)), tfSecs, true)
            sl   := ep - dir * dist
            sbSl := byLim and (dir < 0 ? high >= sl : low <= sl)
            v.entries += 1
            v.lastE   := bar_index
    [fire, ep, sl, dist, sbSl]

if not busy and not spkBlock
    for k = 0 to 1
        int     dir = k == 0 ? 1 : -1
        MajView v   = dir > 0 ? mvB : mvS
        bool    ok  = dir > 0 ? okBuy : okSell
        if not busy and ok
            [f, ep, sl, dist, sb] = majEntry(v, dir, dir > 0 ? mBP0 : mSP0, dir > 0 ? mBP1 : mSP1, dir > 0 ? mBLive : mSLive)
            if f
                Trade nt = openTrade(dir, ep, sl, dist, true, mLbl + " major zone", na, v)
                tLive.push(nt)
                busy := true
                score(dKey, 0, 1)
                lastTrade    := (dir < 0 ? "SELL " : "BUY ") + fmtP(ep) + " · open"
                lastTradeDir := dir
                evSell := evSell or dir < 0
                evBuy  := evBuy or dir > 0
                if sb
                    nt.net := -dist
                    nt.rem := 0.0
                    score(dKey, 2, 1)
                    v.entries := maxEnt
                    closeTrade(nt, "SL")
                    busy := false

// ───────────────────────────── Entries 2 · daily zones (rejection out of the zone)
if not busy and tradeDL and not spkBlock and barstate.isconfirmed and dZLo.size() > 0
    for j = 0 to dZLo.size() - 1
        if not busy and dZW.get(j) >= dlMinW
            float lo = dZLo.get(j)
            float hi = dZHi.get(j)
            bool  bR = okBuy and dZB.get(j) == 0 and close[1] > hi and low <= hi and close > hi and isRej(1)
            bool  sR = okSell and dZS.get(j) == 0 and close[1] < lo and high >= lo and close < lo and isRej(-1)
            if bR or sR
                int   dir  = bR ? 1 : -1
                float dist = clampSl(dir > 0 ? close - (math.min(lo, low) - slBuf * atr) : (math.max(hi, high) + slBuf * atr) - close, tfSecs, true)
                if dir > 0
                    dZB.set(j, 1)
                else
                    dZS.set(j, 1)
                Trade nt = openTrade(dir, close, close - dir * dist, dist, true, "daily zone " + rngTxt(lo, hi), na, na)
                tLive.push(nt)
                busy := true
                score(dKey, 0, 1)
                lastTrade    := (dir < 0 ? "SELL " : "BUY ") + fmtP(close) + " · open"
                lastTradeDir := dir
                evSell := evSell or dir < 0
                evBuy  := evBuy or dir > 0

// ───────────────────────────── Entries 3 · local zones (drawn here too)
for z in zLive
    if z.state <= 1
        legUpdate(z)
        float zA    = lvl(z, fEntry)
        float zB    = lvl(z, fZone)
        float zM    = (zA + zB) / 2
        float top   = math.max(zA, zB)
        float bot   = math.min(zA, zB)
        bool  valid = math.abs(z.p0 - z.p1) >= minLeg * atr
        // not drawn when a live major zone of the same side already covers it
        bool  dup   = false
        if z.dir > 0 and mBLive
            float mt = math.max(mBP1 + fEntry * (mBP0 - mBP1), mBP1 + fZone * (mBP0 - mBP1))
            float mb = math.min(mBP1 + fEntry * (mBP0 - mBP1), mBP1 + fZone * (mBP0 - mBP1))
            dup := math.min(top, mt) - math.max(bot, mb) >= 0.5 * (top - bot)
        if z.dir < 0 and mSLive
            float mt = math.max(mSP1 + fEntry * (mSP0 - mSP1), mSP1 + fZone * (mSP0 - mSP1))
            float mb = math.min(mSP1 + fEntry * (mSP0 - mSP1), mSP1 + fZone * (mSP0 - mSP1))
            dup := math.min(top, mt) - math.max(bot, mb) >= 0.5 * (top - bot)
        color cDir = z.dir < 0 ? cSell : cBuy
        if valid and not dup
            if na(z.bx)
                z.bx  := box.new(z.b1, top, bar_index + 3, bot, border_color = color.new(cDir, 35), border_style = line.style_dashed, border_width = 1, bgcolor = color.new(cZone, 88), text = cLbl + (z.dir < 0 ? " SELL ZONE" : " BUY ZONE"), text_size = size.tiny, text_color = color.new(cDir, 20), text_halign = text.align_right, text_valign = z.dir < 0 ? text.align_top : text.align_bottom)
                z.mid := line.new(z.b1, zM, bar_index + 3, zM, color = color.new(cZone, 45), style = line.style_dotted)
                if showLeg
                    z.lg := line.new(z.b0, z.p0, z.b1, z.p1, color = color.new(cZone, 55), style = line.style_dashed)
            else
                z.bx.set_lefttop(z.b1, top)
                z.bx.set_rightbottom(bar_index + 3, bot)
                z.mid.set_xy1(z.b1, zM)
                z.mid.set_xy2(bar_index + 3, zM)
                if not na(z.lg)
                    z.lg.set_xy1(z.b0, z.p0)
                    z.lg.set_xy2(z.b1, z.p1)
        else if not na(z.bx)
            box.delete(z.bx)
            line.delete(z.mid)
            line.delete(z.lg)
            z.bx  := na
            z.mid := na
            z.lg  := na
        [fire, ep, sl, dist, sbSl] = zoneEval(z, atr, spkBlock, trend, busy or not (z.dir > 0 ? okBuy : okSell), tfSecs)
        if fire
            Trade nt = openTrade(z.dir, ep, sl, dist, false, cLbl + " zone" + (z.entries > 1 ? " (reinforcement)" : ""), z, na)
            tLive.push(nt)
            busy := true
            score(dKey, 0, 1)
            lastTrade    := (z.dir < 0 ? "SELL " : "BUY ") + fmtP(ep) + " · open"
            lastTradeDir := z.dir
            evSell := evSell or z.dir < 0
            evBuy  := evBuy or z.dir > 0
            if sbSl
                nt.net := -dist
                nt.rem := 0.0
                score(dKey, 2, 1)
                z.entries := maxEnt
                closeTrade(nt, "SL")
                busy := false
    if z.state >= 10
        zoneGone(z)

if evBuy or evSell
    for t in tLive
        if t.state == 1 and t.eB == bar_index
            alert("FOXREX Waves " + cLbl + " " + (t.dir < 0 ? "SELL" : "BUY") + " " + syminfo.ticker + " @ " + fmtP(t.entry) + " | SL " + fmtP(t.sl) + " | TP1 " + fmtP(t.tps.get(0)) + " | TP2 " + fmtP(t.tps.get(1)) + " | TP3 " + fmtP(t.tps.get(2)) + " | TP4 " + fmtP(t.tps.get(3)) + " | " + t.src, alert.freq_once_per_bar_close)

// ───────────────────────────── Housekeeping
if zLive.size() > 0
    for i = zLive.size() - 1 to 0
        Zone z = zLive.get(i)
        if z.state >= 10
            zLive.remove(i)
            if showFin
                zArch.push(z)
while zArch.size() > 20
    Zone z = zArch.shift()
    box.delete(z.bx)

if tLive.size() > 0
    for i = tLive.size() - 1 to 0
        Trade t = tLive.get(i)
        if t.state >= 10
            tLive.remove(i)
            tArch.push(t)
while tArch.size() > keepN
    Trade ot = tArch.shift()
    label.delete(ot.lb)
    line.delete(ot.tl)
while bosLn.size() > 30
    line.delete(bosLn.shift())

// ───────────────────────────── Daily zones drawing (last bar; nearest zones per side)
var array<box>   dlB = array.new<box>()
var array<line>  dlL = array.new<line>()
var array<label> dlT = array.new<label>()
float dR1lo = na
float dR1hi = na
float dS1lo = na
float dS1hi = na

if barstate.islast
    for b in dlB
        b.delete()
    dlB.clear()
    for l in dlL
        l.delete()
    dlL.clear()
    for l in dlT
        l.delete()
    dlT.clear()
    int zc = dZLo.size()
    if zc > 0
        int x1 = nz(time("D"), time - 50 * tfSecs * 1000)
        int x2 = time + dlExt * tfSecs * 1000
        int nR = 0
        int nS = 0
        for k = 0 to 1
            for jj = 0 to zc - 1
                int   j  = k == 0 ? jj : zc - 1 - jj
                float lo = dZLo.get(j)
                float hi = dZHi.get(j)
                bool  isR = k == 0 and lo > close and nR < dlN
                bool  isS = k == 1 and hi < close and nS < dlN
                if isR or isS
                    if isR
                        nR += 1
                        if nR == 1
                            dR1lo := lo
                            dR1hi := hi
                    else
                        nS += 1
                        if nS == 1
                            dS1lo := lo
                            dS1hi := hi
                    if showDL
                        float  w  = dZW.get(j)
                        color  c  = isR ? cSell : cBuy
                        string tg = "D1 " + (isR ? "SELL R" + str.tostring(nR) : "BUY S" + str.tostring(nS))
                        dlB.push(box.new(x1, hi, x2, lo, xloc = xloc.bar_time, border_color = color.new(c, 100), bgcolor = color.new(c, w >= 4 ? 88 : 93)))
                        dlL.push(line.new(x1, (lo + hi) / 2, x2, (lo + hi) / 2, xloc = xloc.bar_time, color = color.new(c, w >= 2.5 ? 35 : 60), width = w >= 6 ? 2 : 1))
                        dlT.push(label.new(x2, (lo + hi) / 2, tg + " " + fmtP((lo + hi) / 2), xloc = xloc.bar_time, style = label.style_label_left, color = color.new(c, 100), textcolor = color.new(c, 15), size = size.tiny, tooltip = tg + " · " + rngTxt(lo, hi) + " · strength " + str.tostring(w, "#.#") + "\n" + dZN.get(j)))

// ───────────────────────────── Alerts
alertcondition(evSell, "Sell entry", "FOXREX Waves: SELL entry on {{ticker}} {{interval}}")
alertcondition(evBuy, "Buy entry", "FOXREX Waves: BUY entry on {{ticker}} {{interval}}")

// ───────────────────────────── Dashboard
var table tb = table.new(tbPos == "Top left" ? position.top_left : tbPos == "Bottom right" ? position.bottom_right : tbPos == "Bottom left" ? position.bottom_left : position.top_right, 2, 6, bgcolor = color.new(#0B1320, 10), frame_color = color.new(#A7B6C4, 70), frame_width = 1)

trTxt(int t) =>
    t > 0 ? "▲" : t < 0 ? "▼" : "–"

if barstate.islast and showTb
    color  cTxt = #E5E7EB
    color  cMut = #8A97A8
    string dirTxt = cLbl + " " + trTxt(trend) + (majOn ? "   " + mLbl + " " + trTxt(mTr) : "") + (majBuyAct ? " · in major BUY" : majSellAct ? " · in major SELL" : "")
    int    allow  = okBuy and not okSell ? 1 : okSell and not okBuy ? -1 : okBuy and okSell ? 0 : 9
    string allowTxt = allow == 1 ? "BUY only" : allow == -1 ? "SELL only" : allow == 0 ? "both sides" : "none"
    string openTxt = "none"
    int    openDir = 0
    for t in tLive
        if t.state == 1
            openTxt := (t.dir < 0 ? "SELL " : "BUY ") + fmtP(t.entry) + (t.hits > 0 ? " ✓TP" + str.tostring(t.hits) : "") + " · SL " + fmtP(t.sl)
            openDir := t.dir
    table.cell(tb, 0, 0, "FOXREX Waves", text_color = #F5B942, text_size = size.small, text_halign = text.align_left)
    table.cell(tb, 1, 0, syminfo.ticker + " · " + cLbl, text_color = cTxt, text_size = size.small, text_halign = text.align_right)
    table.cell(tb, 0, 1, "Direction", text_color = cMut, text_size = size.small, text_halign = text.align_left)
    table.cell(tb, 1, 1, dirTxt, text_color = cTxt, text_size = size.small, text_halign = text.align_right)
    table.cell(tb, 0, 2, "Trades allowed", text_color = cMut, text_size = size.small, text_halign = text.align_left)
    table.cell(tb, 1, 2, allowTxt, text_color = allow == 1 ? cBuy : allow == -1 ? cSell : cTxt, text_size = size.small, text_halign = text.align_right)
    table.cell(tb, 0, 3, "Open trade", text_color = cMut, text_size = size.small, text_halign = text.align_left)
    table.cell(tb, 1, 3, openTxt, text_color = openDir < 0 ? cSell : openDir > 0 ? cBuy : cMut, text_size = size.small, text_halign = text.align_right)
    table.cell(tb, 0, 4, "Last trade", text_color = cMut, text_size = size.small, text_halign = text.align_left)
    table.cell(tb, 1, 4, lastTrade, text_color = lastTradeDir < 0 ? cSell : lastTradeDir > 0 ? cBuy : cMut, text_size = size.small, text_halign = text.align_right)
    table.cell(tb, 0, 5, "Daily R1 / S1", text_color = cMut, text_size = size.small, text_halign = text.align_left)
    table.cell(tb, 1, 5, (na(dR1lo) ? "—" : fmtP((dR1lo + dR1hi) / 2)) + " / " + (na(dS1lo) ? "—" : fmtP((dS1lo + dS1hi) / 2)), text_color = cTxt, text_size = size.small, text_halign = text.align_right)

// ───────────────────────────── Daily scorecard (this timeframe only)
var table st = table.new(stPos == "Top left" ? position.top_left : stPos == "Top right" ? position.top_right : stPos == "Bottom left" ? position.bottom_left : position.bottom_right, 7, 4, bgcolor = color.new(#0B1320, 10), frame_color = color.new(#A7B6C4, 70), frame_width = 1)

stRow(table t, int r, string name, array<float> a) =>
    float n  = a.get(0)
    float w  = a.get(1)
    float l  = a.get(2)
    float pt = a.get(3)
    float wr = n > 0 ? w / n * 100 : na
    color cT = #E5E7EB
    table.cell(t, 0, r, name, text_color = #8A97A8, text_size = size.small, text_halign = text.align_left)
    table.cell(t, 1, r, str.tostring(n, "#"), text_color = cT, text_size = size.small)
    table.cell(t, 2, r, str.tostring(w, "#"), text_color = #00D4A7, text_size = size.small)
    table.cell(t, 3, r, str.tostring(l, "#"), text_color = #FF5C7A, text_size = size.small)
    table.cell(t, 4, r, na(wr) ? "—" : str.tostring(wr, "#") + "%", text_color = na(wr) ? #8A97A8 : wr >= 50 ? #00D4A7 : #FF5C7A, text_size = size.small)
    table.cell(t, 5, r, sgnPts(pt), text_color = pt > 0 ? #00D4A7 : pt < 0 ? #FF5C7A : cT, text_size = size.small)
    float us = a.get(4)
    table.cell(t, 6, r, usd(us), text_color = us > 0 ? #00D4A7 : us < 0 ? #FF5C7A : cT, text_size = size.small)
    true

if barstate.islast and showSt
    color cH = #F5B942
    table.cell(st, 0, 0, "Scorecard " + cLbl, text_color = cH, text_size = size.small, text_halign = text.align_left)
    table.cell(st, 1, 0, "Trades", text_color = cH, text_size = size.small)
    table.cell(st, 2, 0, "Win", text_color = cH, text_size = size.small)
    table.cell(st, 3, 0, "Loss", text_color = cH, text_size = size.small)
    table.cell(st, 4, 0, "Win %", text_color = cH, text_size = size.small)
    table.cell(st, 5, 0, "Net pts", text_color = cH, text_size = size.small)
    table.cell(st, 6, 0, "1 lot $", text_color = cH, text_size = size.small)
    stRow(st, 1, "Today", stT)
    stRow(st, 2, "Yesterday", stY)
    stRow(st, 3, "All on chart", stA)
