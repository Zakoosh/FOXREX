// FOXREX · Wave Retracement Zones
// Sequential buy / sell zones from wave retracements.
// Local zones: the chart's own timeframe (grey fill, dashed border in the side colour, labelled with the timeframe).
// Major zones: a higher timeframe (default 15 minutes), drawn on every lower timeframe with a solid coloured
// border and the timeframe in the label, e.g. "M15 BUY ZONE · MAJOR".
// 1. Swings are confirmed pivots (swing length bars on each side).
// 2. Break of structure (BOS): a candle closes beyond the last swing high (bullish) or swing low (bearish).
// 3. Leg start (fib 0%): by default the first price stall after the break. When the wave is clean and
//    pauses shortly after the break, the low of that pause (high for sells) becomes the new start of the
//    leg once price closes beyond the pause and continues. Otherwise the swing that started the move.
//    The leg end (fib 100%) follows new extremes until price first comes back to the zone.
// 4. Zone = retracement between "Zone start" (default 50%) and "Zone end" (default 61.8%) of the leg.
//    Zones stay until price closes beyond the invalidation level (default 78.6%). On intraday charts,
//    finished zones and trades from previous days are hidden.
// 5. Entry (default): limit at the middle of the zone, or a rejection candle in the zone (bullish / bearish
//    close or a pin bar), whichever comes first. One trade at a time on each timeframe: no new entry while
//    a trade is open, and a new signal never closes the open trade. After a trade closes, the zone can give
//    a reinforcement entry ("+") once price has moved away and comes back.
// 6. Major filter (default): while price is reacting inside an active major zone (touched, not invalidated,
//    leg extreme not yet broken), local entries against that zone are blocked.
//    Trades from other timeframes are not mixed in: the chart shows its own trades, plus the major
//    timeframe's trade only while that trade is open.
// 7. Four targets in points (default 2.5 / 5 / 10 / 20), recorded the moment price touches them.
//    Stop at the zone invalidation or fixed points, between 3 and 10 points (up to 50 on D/W/M charts).
//    Profit protection (default "Step"): after TP1 the stop moves to entry, after TP2 to TP1, after TP3 to TP2.
//    A trade that reached a target is a win and is never shown as a stop loss: it ends as "BE" or "locked".
//    Result points = the highest target reached (or the stop loss when no target was reached).
// 7b. Daily buy / sell zones (support / resistance from the daily engine of FOXREX Levels) are drawn on
//     every timeframe from the start of today's session, in a light fill with labels on the right edge.
// 8. Abnormal-candle filter and daily scorecard (trades, wins = TP1 reached, losses, win rate, net points).
// Nothing repaints: swings confirm after the right-side bars, every decision uses closed bars, and the
// major timeframe is read from its last closed bar.
// Educational tool, not investment advice.

//@version=6
indicator("FOXREX · Wave Retracement Zones", shorttitle = "FOXREX Waves", overlay = true, max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500, max_bars_back = 500)

// ───────────────────────────── Inputs
string G1      = "Structure"
int    swLen   = input.int(5, "Swing length (bars each side)", minval = 1, maxval = 50, group = G1, display = display.none)
bool   useWick = input.bool(false, "Break on wick (off = candle close)", group = G1, display = display.none)
bool   showBos = input.bool(true, "Show BOS lines", group = G1, display = display.none)
string anchor  = input.string("First stall after the break", "Leg start (fib 0%)", options = ["First stall after the break", "Swing before the break"], group = G1, tooltip = "First stall after the break: when price pauses after breaking the high (low) and then closes beyond the pause, the pause low (high) becomes fib 0%. If the pause retraces into the zone first, the swing before the break stays the start.", display = display.none)

string G2      = "Retracement zone"
float  fEntry  = input.float(0.5, "Zone start (retracement)", minval = 0.236, maxval = 0.886, step = 0.01, group = G2, display = display.none)
float  fZone   = input.float(0.618, "Zone end (retracement)", minval = 0.236, maxval = 0.95, step = 0.01, group = G2, display = display.none)
float  fInv    = input.float(0.786, "Invalidation (retracement)", minval = 0.5, maxval = 1.0, step = 0.01, group = G2, tooltip = "A candle close beyond this level ends the zone. 1.0 = the start of the leg", display = display.none)
float  minLeg  = input.float(1.5, "Minimum leg size (× ATR)", minval = 0.0, step = 0.1, group = G2, display = display.none)
int    maxWait = input.int(300, "Zone life (bars after the leg end)", minval = 5, group = G2, display = display.none)
string trig    = input.string("Middle limit or rejection", "Entry", options = ["Middle limit or rejection", "Limit at zone middle", "Rejection candle", "Touch"], group = G2, tooltip = "Middle limit or rejection: whichever comes first, a fill at the middle of the box (entry = that price) or a candle that dips into the zone and closes back in the trend direction or as a pin bar (entry = candle close).", display = display.none)
int    maxEnt  = input.int(3, "Max entries per zone (1 = no reinforcement)", minval = 1, maxval = 10, group = G2, display = display.none)
int    reCool  = input.int(3, "Bars between entries in the same zone", minval = 1, group = G2, display = display.none)
bool   withTr  = input.bool(true, "Only trade with the current structure (last BOS)", group = G2, tooltip = "Sell zones give entries only while the last break was bearish, buy zones only while it was bullish", display = display.none)

string G6      = "Major timeframe"
bool   showMaj = input.bool(true, "Show major zones from a higher timeframe", group = G6, display = display.none)
string majTf   = input.timeframe("15", "Major timeframe", group = G6, tooltip = "Major zones and the major open trade are drawn on every chart timeframe lower than this one", display = display.none)
string majBlk  = input.string("Active major zone", "Block local entries against", options = ["Active major zone", "Major structure (last BOS)", "Off"], group = G6, tooltip = "Active major zone: while price is reacting inside a major buy zone (touched, not invalidated, leg high not yet broken), local sells are blocked, and the reverse for a major sell zone.", display = display.none)
bool   showMjT = input.bool(true, "Show the major timeframe's trade while it is open", group = G6, display = display.none)

string G3      = "Trade"
float  tp1Pts  = input.float(2.5, "TP1 (points)", minval = 0.0, step = 0.5, group = G3, inline = "t1", display = display.none)
float  tp2Pts  = input.float(5.0, "TP2", minval = 0.0, step = 0.5, group = G3, inline = "t1", display = display.none)
float  tp3Pts  = input.float(10.0, "TP3 (points)", minval = 0.0, step = 0.5, group = G3, inline = "t2", display = display.none)
float  tp4Pts  = input.float(20.0, "TP4", minval = 0.0, step = 0.5, group = G3, inline = "t2", display = display.none)
string slMode  = input.string("Zone invalidation", "Stop", options = ["Zone invalidation", "Fixed points"], group = G3, display = display.none)
float  slPts   = input.float(8.0, "Stop (points, fixed mode)", minval = 0.0, step = 0.5, group = G3, display = display.none)
float  slMax   = input.float(10.0, "Maximum stop (points, 0 = no cap)", minval = 0.0, step = 0.5, group = G3, display = display.none)
float  slMaxD  = input.float(50.0, "Maximum stop on D / W / M charts (points)", minval = 0.0, step = 1.0, group = G3, display = display.none)
float  slMin   = input.float(3.0, "Minimum stop (points)", minval = 0.0, step = 0.5, group = G3, tooltip = "Stops tighter than this sit inside normal noise (spread + one-minute wicks) and get hit before the idea can work", display = display.none)
float  slBuf   = input.float(0.1, "Stop buffer (× ATR, zone mode)", minval = 0.0, step = 0.05, group = G3, display = display.none)
string protect = input.string("Step: entry after TP1, then previous target", "Profit protection", options = ["Step: entry after TP1, then previous target", "Entry after TP1 only", "Off (keep the original stop)"], group = G3, tooltip = "Step: after TP1 the stop moves to the entry (break-even), after TP2 to TP1, after TP3 to TP2. A trade that touched a target can no longer turn into a loss.", display = display.none)
string acct    = input.string("Highest target reached", "Result points", options = ["Highest target reached", "25% closed at each target"], group = G3, display = display.none)
int    maxBars = input.int(200, "Close trade after (bars)", minval = 5, group = G3, display = display.none)

string G5      = "Abnormal candle filter"
bool   useSpk  = input.bool(true, "Skip signals after an abnormal candle", group = G5, display = display.none)
float  spkK    = input.float(2.5, "Abnormal = range above (× ATR)", minval = 1.0, step = 0.1, group = G5, display = display.none)
float  spkPts  = input.float(0.0, "…or range above (points, 0 = off)", minval = 0.0, step = 0.5, group = G5, display = display.none)
int    spkLook = input.int(3, "Look back (bars)", minval = 1, maxval = 20, group = G5, display = display.none)

string G7      = "Daily levels (all timeframes)"
bool   showDL   = input.bool(true, "Show daily buy / sell zones", group = G7, tooltip = "Today's daily support (buy) and resistance (sell) zones, same engine as FOXREX Levels: prior day high/low/close, daily pivots, prior week high/low, 20-day range, daily swings, 20/50-day EMAs, round numbers and analyst levels. Drawn from the start of today's session on every timeframe.", display = display.none)
int    dlN      = input.int(3, "Zones per side", minval = 1, maxval = 6, group = G7, display = display.none)
float  dlRange  = input.float(3.0, "Search range (× daily ATR)", minval = 1.0, step = 0.5, group = G7, display = display.none)
float  dlMerge  = input.float(0.12, "Merge distance (× daily ATR)", minval = 0.02, step = 0.02, group = G7, display = display.none)
bool   dlSwing  = input.bool(true, "Include daily swing highs / lows", group = G7, display = display.none)
float  dlStep   = input.float(0.0, "Round-number step (0 = auto)", minval = 0.0, group = G7, display = display.none)
string dlAn     = input.string("", "Analyst levels (comma separated)", group = G7, tooltip = "Paste today's levels from FOXREX Admin → Trading → TradingView indicator", display = display.none)
int    dlExt    = input.int(15, "Extend right (bars)", minval = 0, maxval = 200, group = G7, display = display.none)

string G4      = "Display"
bool   showOld = input.bool(false, "Show zones and trades from previous days (always on for D/W/M)", group = G4, display = display.none)
bool   showLn  = input.bool(true, "Show entry / SL / TP lines of the open trade", group = G4, display = display.none)
bool   showLeg = input.bool(true, "Show the leg (fib 0% → 100%)", group = G4, display = display.none)
int    keepN   = input.int(60, "Finished trade labels kept", minval = 1, maxval = 200, group = G4, display = display.none)
int    keepZ   = input.int(30, "Finished zones kept", minval = 1, maxval = 150, group = G4, display = display.none)
bool   showTb  = input.bool(true, "Dashboard", group = G4, display = display.none)
string tbPos   = input.string("Top right", "Dashboard position", options = ["Top right", "Top left", "Bottom right", "Bottom left"], group = G4, display = display.none)
bool   showSt  = input.bool(true, "Daily scorecard", group = G4, display = display.none)
string stPos   = input.string("Bottom right", "Scorecard position", options = ["Top right", "Top left", "Bottom right", "Bottom left"], group = G4, display = display.none)
color  cSell   = input.color(#FF5C7A, "Sell", group = G4, inline = "c", display = display.none)
color  cBuy    = input.color(#00D4A7, "Buy", group = G4, inline = "c", display = display.none)
color  cZone   = input.color(#9CA3AF, "Zones", group = G4, inline = "c", display = display.none)

// ───────────────────────────── Types & helpers
type Zone
    int   dir
    float p0
    int   b0
    float p1
    int   b1
    int   state
    bool  touched
    int   entries
    int   lastE
    int   dKey
    box   bx
    line  mid
    line  lg
    int   bB
    int   sSt
    float sLo
    int   sLoB
    float sHi
    bool  armed
    int   t1
    int   tB

type Trade
    int          dir
    float        entry
    float        sl
    float        risk0
    array<float> tps
    int          hits
    int          eB
    int          dKey
    float        net
    float        rem
    int          state
    bool         add
    label        lb
    array<line>  ln
    Zone         zn

type MajView
    box   bx
    line  mid
    int   id
    bool  tch

// Retracement level r of the leg (0 = leg end, 1 = leg start) — works for both directions.
lvl(Zone z, float r) =>
    z.p1 + r * (z.p0 - z.p1)

fmtP(float v) =>
    v >= 10000 ? str.tostring(v, "#,##0") : v >= 100 ? str.tostring(v, "#,##0.00") : str.tostring(v, format.mintick)

pct(float r) =>
    str.tostring(r * 100, "#.#") + "%"

sgnPts(float v) =>
    (v > 0 ? "+" : "") + str.tostring(v, "#.##") + " pts"

tfLabel(string tf) =>
    int s = timeframe.in_seconds(tf)
    s < 60 ? str.tostring(s) + "s" : s < 3600 ? "M" + str.tostring(math.round(s / 60)) : s < 86400 ? "H" + str.tostring(math.round(s / 3600)) : s < 604800 ? "D" + str.tostring(math.round(s / 86400)) : tf

tpAt(int i) =>
    i == 0 ? tp1Pts : i == 1 ? tp2Pts : i == 2 ? tp3Pts : tp4Pts

// Stop after profit protection, for a trade that has reached `hits` targets.
protSl(int dir, float en, float sl, int hits) =>
    float r = sl
    if protect != "Off (keep the original stop)" and hits >= 1
        float ns = protect == "Step: entry after TP1, then previous target" and hits >= 2 ? en + dir * tpAt(hits - 2) : en
        if dir * (ns - r) > 0
            r := ns
    r

// Highest high (dir = -1) or lowest low (dir = +1) since bar fromB: the swing that started the move.
legStart(int dir, int fromB) =>
    int   n     = na(fromB) ? 50 : math.min(math.max(bar_index - fromB, 1), 450)
    float best  = dir < 0 ? high : low
    int   bestB = bar_index
    for i = 0 to n
        float v = dir < 0 ? high[i] : low[i]
        if (dir < 0 and v > best) or (dir > 0 and v < best)
            best  := v
            bestB := bar_index - i
    [best, bestB]

newZone(int dir, float p0, int b0, int k) =>
    Zone.new(dir, p0, b0, dir < 0 ? low : high, bar_index, 0, false, 0, na, k, na, na, na, bar_index, anchor == "Swing before the break" ? 3 : 0, na, na, na, true, time, time)

// Leg update while the zone is forming: first stall after the break → fib 0%, new extremes → fib 100%.
legUpdate(Zone z) =>
    if z.state == 0 and z.sSt < 2 and barstate.isconfirmed and bar_index > z.bB
        bool ext = z.dir > 0 ? high > z.p1 : low < z.p1
        if z.sSt == 0
            if not ext
                z.sSt  := 1
                z.sHi  := z.p1
                z.sLo  := z.dir > 0 ? low : high
                z.sLoB := bar_index
        else
            if z.dir > 0 ? low < z.sLo : high > z.sLo
                z.sLo  := z.dir > 0 ? low : high
                z.sLoB := bar_index
            if z.dir > 0 ? close > z.sHi : close < z.sHi
                if z.dir > 0 ? z.sLo > z.p0 : z.sLo < z.p0
                    z.p0 := z.sLo
                    z.b0 := z.sLoB
                z.sSt := 2
    if z.state == 0 and bar_index > z.b1 and (z.dir < 0 ? low < z.p1 : high > z.p1)
        z.p1 := z.dir < 0 ? low : high
        z.b1 := bar_index
        z.t1 := time
    true

// Zone touch / invalidation / entry decision on a closed bar. Returns [fire, entry, stop, stop points, touched now, stopped on the fill candle].
zoneEval(Zone z, float a, bool sBlk, int tr, bool blocked) =>
    bool  fire = false
    bool  tNow = false
    bool  sbSl = false
    float ep   = na
    float sl   = na
    float dist = na
    if z.state <= 1
        float zA    = lvl(z, fEntry)
        float zB    = lvl(z, fZone)
        float zI    = lvl(z, fInv)
        float zM    = (zA + zB) / 2
        bool  valid = math.abs(z.p0 - z.p1) >= minLeg * a
        if valid and bar_index > z.b1 and barstate.isconfirmed
            float rg      = high - low
            bool  inZone  = z.dir < 0 ? high >= zA : low <= zA
            bool  hitMid  = z.dir < 0 ? high >= zM : low <= zM
            bool  invalid = z.dir < 0 ? close > zI : close < zI
            bool  rej     = z.dir < 0 ? close < zB and (close < open or high - close >= 0.6 * rg) : close > zB and (close > open or close - low >= 0.6 * rg)
            // re-arm for a reinforcement entry once price has moved TP1 away from the zone middle
            if not z.armed and (z.dir < 0 ? low <= zM - tp1Pts : high >= zM + tp1Pts)
                z.armed := true
            if inZone and not z.touched
                z.touched := true
                z.state   := 1
                tNow      := true
            bool useLim = trig == "Middle limit or rejection" or trig == "Limit at zone middle"
            bool useRej = trig == "Middle limit or rejection" or trig == "Rejection candle"
            bool byLim  = useLim and hitMid
            bool byRej  = not byLim and useRej and inZone and rej and not invalid
            bool byTch  = trig == "Touch" and inZone and not invalid
            if (byLim or byRej or byTch) and z.armed and not blocked and not sBlk and (not withTr or z.dir == tr) and z.entries < maxEnt and (na(z.lastE) or bar_index - z.lastE >= reCool)
                fire := true
                ep   := byLim ? (z.dir < 0 ? math.max(zM, open) : math.min(zM, open)) : close
                float zSl = z.dir < 0 ? (byLim ? zI : math.max(zI, high)) + slBuf * a : (byLim ? zI : math.min(zI, low)) - slBuf * a
                dist := slMode == "Fixed points" ? slPts : math.abs(ep - zSl)
                dist := math.max(dist, slMin)
                float cap = timeframe.isdwm ? slMaxD : slMax
                if cap > 0
                    dist := math.min(dist, cap)
                sl   := ep - z.dir * dist
                sbSl := byLim and (z.dir < 0 ? high >= sl : low <= sl)
                z.entries += 1
                z.lastE   := bar_index
            if invalid
                z.state := 13
        if z.state <= 1 and bar_index - z.b1 > maxWait
            z.state := 14
    [fire, ep, sl, dist, tNow, sbSl]

// ───────────────────────────── Major timeframe engine (evaluated on the major timeframe through request.security)
majorEngine() =>
    float a  = ta.atr(14)
    float hh = ta.pivothigh(high, swLen, swLen)
    float ll = ta.pivotlow(low, swLen, swLen)
    var float hP   = na
    var int   hB   = na
    var bool  hU   = true
    var float lP   = na
    var int   lB   = na
    var bool  lU   = true
    var int   tr   = 0
    var float bos  = na
    var Zone  zS   = na
    var Zone  zBy  = na
    var int   tDir = 0
    var float tEn  = na
    var float tSl  = na
    var int   tHit = 0
    var int   tEB  = na
    var int   tT   = na
    var Zone  tZ   = na
    if not na(hh)
        hP := hh
        hB := bar_index - swLen
        hU := false
    if not na(ll)
        lP := ll
        lB := bar_index - swLen
        lU := false
    bool  dn   = barstate.isconfirmed and not lU and not na(lP) and (useWick ? low : close) < lP
    bool  up   = barstate.isconfirmed and not hU and not na(hP) and (useWick ? high : close) > hP
    float aP   = nz(a[1], a)
    bool  spk  = (high - low) > spkK * aP or (spkPts > 0 and (high - low) > spkPts)
    int   sAgo = ta.barssince(spk)
    bool  sBlk = useSpk and not na(sAgo) and sAgo < spkLook
    if dn
        lU  := true
        tr  := -1
        bos := lP
        if na(zS) or zS.state != 0
            [p0, b0] = legStart(-1, hB)
            zS := newZone(-1, p0, b0, 0)
    if up
        hU  := true
        tr  := 1
        bos := hP
        if na(zBy) or zBy.state != 0
            [p0, b0] = legStart(1, lB)
            zBy := newZone(1, p0, b0, 0)
    // open major trade → outcome
    if tDir != 0 and barstate.isconfirmed and bar_index > tEB
        if tDir < 0 ? high >= tSl : low <= tSl
            if tHit == 0
                tZ.entries := maxEnt
            tZ.armed := false
            tDir     := 0
        else
            while tHit < 4 and (tDir < 0 ? low <= tEn - tpAt(tHit) : high >= tEn + tpAt(tHit))
                tHit += 1
            tSl := protSl(tDir, tEn, tSl, tHit)
            if tHit == 4 or bar_index - tEB >= maxBars
                tZ.armed := false
                tDir     := 0
    // zones → entries
    if not na(zS)
        legUpdate(zS)
        [f, ep, sl, d, tn, sb] = zoneEval(zS, a, sBlk, tr, tDir != 0)
        if f and not sb
            tDir := -1
            tEn  := ep
            tSl  := sl
            tHit := 0
            tEB  := bar_index
            tT   := time
            tZ   := zS
        else if f and sb
            zS.entries := maxEnt
            zS.armed   := false
    if not na(zBy)
        legUpdate(zBy)
        [f, ep, sl, d, tn, sb] = zoneEval(zBy, a, sBlk, tr, tDir != 0)
        if f and not sb
            tDir := 1
            tEn  := ep
            tSl  := sl
            tHit := 0
            tEB  := bar_index
            tT   := time
            tZ   := zBy
        else if f and sb
            zBy.entries := maxEnt
            zBy.armed   := false
    bool sV = not na(zS) and math.abs(zS.p0 - zS.p1) >= minLeg * a
    bool bV = not na(zBy) and math.abs(zBy.p0 - zBy.p1) >= minLeg * a
    [sV ? zS.p0 : na, sV ? zS.p1 : na, sV ? zS.t1 : na, sV ? zS.state : -1, sV ? zS.tB : na, bV ? zBy.p0 : na, bV ? zBy.p1 : na, bV ? zBy.t1 : na, bV ? zBy.state : -1, bV ? zBy.tB : na, tr, bos, tDir, tEn, tSl, tHit, tT]

// Values of the last closed major bar (no repainting).
majorPack() =>
    [a1, a2, a3, a4, a5, b1, b2, b3, b4, b5, c1, c2, d1, d2, d3, d4, d5] = majorEngine()
    [a1[1], a2[1], a3[1], a4[1], a5[1], b1[1], b2[1], b3[1], b4[1], b5[1], c1[1], c2[1], d1[1], d2[1], d3[1], d4[1], d5[1]]

bool   majOn = showMaj and timeframe.in_seconds() < timeframe.in_seconds(majTf)
string mTf   = majOn ? majTf : timeframe.period
[mSP0, mSP1, mST1, mSSt, mSId, mBP0, mBP1, mBT1, mBSt, mBId, mTr, mBos, mTDir, mTEn, mTSl, mTHit, mTT] = request.security(syminfo.tickerid, mTf, majorPack(), lookahead = barmerge.lookahead_on)
string mLbl  = tfLabel(majTf)

zoneFade(Zone z) =>
    if not na(z.bx)
        z.bx.set_right(bar_index)
        z.bx.set_bgcolor(color.new(cZone, 94))
        z.bx.set_border_color(color.new(z.dir < 0 ? cSell : cBuy, 75))
        z.bx.set_text_color(color.new(cZone, 40))
    if not na(z.mid)
        z.mid.set_x2(bar_index)
        z.mid.set_color(color.new(cZone, 65))
    if not na(z.lg)
        z.lg.set_color(color.new(cZone, 75))
    true

zoneWipe(Zone z) =>
    box.delete(z.bx)
    line.delete(z.mid)
    line.delete(z.lg)
    true

// ───────────────────────────── Swings, structure, filters, day keys
float atr = ta.atr(14)
float ph  = ta.pivothigh(high, swLen, swLen)
float pl  = ta.pivotlow(low, swLen, swLen)

var float shP     = na
var int   shB     = na
var bool  shUsed  = true
var float slP     = na
var int   slB     = na
var bool  slUsed  = true
var int   trend   = 0
var float lastBos = na

if not na(ph)
    shP    := ph
    shB    := bar_index - swLen
    shUsed := false
if not na(pl)
    slP    := pl
    slB    := bar_index - swLen
    slUsed := false

bool bosDn = barstate.isconfirmed and not slUsed and not na(slP) and (useWick ? low : close) < slP
bool bosUp = barstate.isconfirmed and not shUsed and not na(shP) and (useWick ? high : close) > shP

// abnormal candle filter (ATR of the previous bar, so the spike does not inflate its own benchmark)
float atrPrev  = nz(atr[1], atr)
bool  spike    = (high - low) > spkK * atrPrev or (spkPts > 0 and (high - low) > spkPts)
int   spkAgo   = ta.barssince(spike)
bool  spkBlock = useSpk and not na(spkAgo) and spkAgo < spkLook

// trading-day key, scorecard buckets (0 trades, 1 wins, 2 losses, 3 net points)
int  dKey    = year(time_tradingday) * 10000 + month(time_tradingday) * 100 + dayofmonth(time_tradingday)
bool keepAll = showOld or timeframe.isdwm
var int dToday = na
var int dYest  = na
var array<float> stT = array.new<float>(4, 0.0)
var array<float> stY = array.new<float>(4, 0.0)
var array<float> stA = array.new<float>(4, 0.0)

var array<Zone>  zLive  = array.new<Zone>()
var array<Zone>  zArch  = array.new<Zone>()
var array<Trade> tLive  = array.new<Trade>()
var array<Trade> tArch  = array.new<Trade>()
var array<line>  bosLn  = array.new<line>()
var array<label> bosLb  = array.new<label>()
var array<box>   mOld   = array.new<box>()

bool newDay = na(dToday) or dKey != dToday
if newDay
    if not na(dToday)
        stY   := stT.copy()
        dYest := dToday
    stT    := array.new<float>(4, 0.0)
    dToday := dKey
    if not keepAll
        // previous days: hide finished zones, finished trades and BOS marks
        for z in zArch
            zoneWipe(z)
        zArch.clear()
        for t in tArch
            label.delete(t.lb)
        tArch.clear()
        for l in bosLn
            l.delete()
        bosLn.clear()
        for l in bosLb
            l.delete()
        bosLb.clear()
        for b in mOld
            b.delete()
        mOld.clear()

bump(array<float> a, int i, float v) =>
    a.set(i, a.get(i) + v)
    true

score(int key, int i, float v) =>
    bump(stA, i, v)
    if key == dToday
        bump(stT, i, v)
    else if key == dYest
        bump(stY, i, v)
    true

// Close a trade: result points, scorecard, remove its lines, keep one label with side, result, points.
closeTrade(Trade t, string res) =>
    t.state := 10
    if acct == "Highest target reached"
        t.net := t.hits > 0 ? math.abs(t.tps.get(t.hits - 1) - t.entry) : t.net
    score(t.dKey, 3, t.net)
    for l in t.ln
        l.delete()
    t.ln.clear()
    bool won = t.hits > 0 or t.net > 0
    t.lb.set_text((t.dir < 0 ? "SELL" : "BUY") + (t.add ? " + " : " ") + res + "  " + sgnPts(t.net))
    t.lb.set_size(won ? (t.add ? size.tiny : size.small) : size.tiny)
    t.lb.set_color(won ? (t.dir < 0 ? #E0475F : #00A884) : color.new(#6B7280, 20))
    t.lb.set_textcolor(won ? color.white : color.new(color.white, 25))
    // the zone can give a reinforcement entry only after price has moved away and comes back
    t.zn.armed := false
    true

// ───────────────────────────── Major zones on this chart
var MajView mvS = MajView.new(na, na, na, false)
var MajView mvB = MajView.new(na, na, na, false)

mzDraw(MajView v, int dir, float p0, float p1, int t1, int st, int id) =>
    if majOn and not na(id) and st >= 0
        float zA  = p1 + fEntry * (p0 - p1)
        float zB  = p1 + fZone * (p0 - p1)
        float zM  = (zA + zB) / 2
        float top = math.max(zA, zB)
        float bot = math.min(zA, zB)
        color c   = dir < 0 ? cSell : cBuy
        int   rx  = time + 4 * timeframe.in_seconds() * 1000
        if na(v.id) or v.id != id
            if not na(v.bx)
                v.bx.set_bgcolor(color.new(c, 94))
                v.bx.set_border_color(color.new(c, 70))
                mOld.push(v.bx)
                line.delete(v.mid)
            v.id  := id
            v.tch := false
            v.bx  := box.new(t1, top, rx, bot, xloc = xloc.bar_time, border_color = color.new(c, 10), border_width = 2, bgcolor = color.new(c, 85), text = mLbl + (dir < 0 ? " SELL ZONE · MAJOR" : " BUY ZONE · MAJOR"), text_size = size.small, text_color = c, text_halign = text.align_left, text_valign = dir < 0 ? text.align_top : text.align_bottom)
            v.mid := line.new(t1, zM, rx, zM, xloc = xloc.bar_time, color = color.new(c, 40), style = line.style_dashed, width = 1)
        if st <= 1
            v.bx.set_lefttop(t1, top)
            v.bx.set_rightbottom(rx, bot)
            v.mid.set_xy1(t1, zM)
            v.mid.set_xy2(rx, zM)
            v.bx.set_text(mLbl + (dir < 0 ? " SELL ZONE · MAJOR · " : " BUY ZONE · MAJOR · ") + fmtP(bot) + "–" + fmtP(top))
            if dir > 0 ? low <= zA : high >= zA
                v.tch := true
        else
            v.bx.set_bgcolor(color.new(c, 94))
            v.bx.set_border_color(color.new(c, 70))
            v.mid.set_color(color.new(c, 80))
    true

mzDraw(mvS, -1, mSP0, mSP1, mST1, mSSt, mSId)
mzDraw(mvB, 1, mBP0, mBP1, mBT1, mBSt, mBId)
while mOld.size() > 10
    box.delete(mOld.shift())

// A major zone is "active" while price reacts inside it: touched, not invalidated, leg extreme not yet broken.
bool majSellAct = majOn and mSSt >= 0 and mSSt <= 1 and (mSSt == 1 or mvS.tch) and close < mSP1 + fInv * (mSP0 - mSP1) and close > mSP1
bool majBuyAct  = majOn and mBSt >= 0 and mBSt <= 1 and (mBSt == 1 or mvB.tch) and close > mBP1 + fInv * (mBP0 - mBP1) and close < mBP1
bool blkBuy     = majBlk == "Active major zone" ? majSellAct : majBlk == "Major structure (last BOS)" ? majOn and mTr < 0 : false
bool blkSell    = majBlk == "Active major zone" ? majBuyAct : majBlk == "Major structure (last BOS)" ? majOn and mTr > 0 : false

// Major open trade (shown only while it is open)
var array<line> mTl  = array.new<line>()
var label       mTlb = na
var int         mTid = na
if majOn and showMjT and mTDir != 0 and not na(mTT)
    color c = mTDir < 0 ? cSell : cBuy
    if na(mTid) or mTid != mTT
        for l in mTl
            l.delete()
        mTl.clear()
        label.delete(mTlb)
        mTid := mTT
        mTl.push(line.new(mTT, mTSl, time, mTSl, xloc = xloc.bar_time, color = color.new(cSell, 10), style = line.style_dashed, width = 2))
        for i = 0 to 3
            float p = mTEn + mTDir * tpAt(i)
            mTl.push(line.new(mTT, p, time, p, xloc = xloc.bar_time, color = color.new(cBuy, 30), style = line.style_dotted, width = 2))
        mTl.push(line.new(mTT, mTEn, time, mTEn, xloc = xloc.bar_time, color = color.new(color.white, 10), width = 2))
        mTlb := label.new(mTT, mTEn, "", xloc = xloc.bar_time, style = mTDir < 0 ? label.style_label_down : label.style_label_up, color = color.new(c, 10), textcolor = color.white, size = size.small)
    for l in mTl
        l.set_x2(time)
    mTl.get(0).set_y1(mTSl)
    mTl.get(0).set_y2(mTSl)
    mTlb.set_text(mLbl + (mTDir < 0 ? " SELL" : " BUY") + " @ " + fmtP(mTEn) + (mTHit > 0 ? " ✓TP" + str.tostring(mTHit) : "") + " · open")
    mTlb.set_tooltip("Major " + mLbl + " trade\nSL " + fmtP(mTSl) + "\nTP1 " + fmtP(mTEn + mTDir * tp1Pts) + " · TP2 " + fmtP(mTEn + mTDir * tp2Pts) + "\nTP3 " + fmtP(mTEn + mTDir * tp3Pts) + " · TP4 " + fmtP(mTEn + mTDir * tp4Pts))
else if not na(mTid)
    for l in mTl
        l.delete()
    mTl.clear()
    label.delete(mTlb)
    mTid := na

// ───────────────────────────── Daily buy / sell zones (previous completed sessions → no repaint)
dailyPack() =>
    float dph = ta.pivothigh(high, 2, 2)
    float dpl = ta.pivotlow(low, 2, 2)
    bool  hPh = not na(dph)
    bool  hPl = not na(dpl)
    [high[1], low[1], close[1], ta.highest(high, 20)[1], ta.lowest(low, 20)[1], ta.ema(close, 20)[1], ta.ema(close, 50)[1], ta.atr(14)[1], ta.valuewhen(hPh, dph, 0)[1], ta.valuewhen(hPh, dph, 1)[1], ta.valuewhen(hPh, dph, 2)[1], ta.valuewhen(hPh, dph, 3)[1], ta.valuewhen(hPl, dpl, 0)[1], ta.valuewhen(hPl, dpl, 1)[1], ta.valuewhen(hPl, dpl, 2)[1], ta.valuewhen(hPl, dpl, 3)[1]]

[dH, dL, dC, d20H, d20L, dE20, dE50, dAtr, sh0, sh1, sh2, sh3, sl0, sl1, sl2, sl3] = request.security(syminfo.tickerid, "D", dailyPack(), lookahead = barmerge.lookahead_on)
[wH, wL] = request.security(syminfo.tickerid, "W", [high[1], low[1]], lookahead = barmerge.lookahead_on)

rngTxt(float lo, float hi) =>
    hi - lo < syminfo.mintick * 2 ? fmtP(hi) : fmtP(lo) + "–" + fmtP(hi)

addLv(array<float> lp, array<float> lw, array<string> ln, float p, float w, string n, float px, float lim) =>
    bool ok = not na(p) and not na(lim) and math.abs(p - px) <= lim
    if ok
        lp.push(p)
        lw.push(w)
        ln.push(n)
    ok

var array<box>   dlB = array.new<box>()
var array<line>  dlL = array.new<line>()
var array<label> dlT = array.new<label>()
float dR1lo = na
float dR1hi = na
float dS1lo = na
float dS1hi = na

if barstate.islast
    for b in dlB
        b.delete()
    dlB.clear()
    for l in dlL
        l.delete()
    dlL.clear()
    for l in dlT
        l.delete()
    dlT.clear()
    if not na(dAtr) and not na(dH)
        float pvP = (dH + dL + dC) / 3
        float px  = close
        float lim = dlRange * dAtr
        array<float>  lp = array.new<float>()
        array<float>  lw = array.new<float>()
        array<string> ln = array.new<string>()
        addLv(lp, lw, ln, dH, 3.0, "Prior-day high", px, lim)
        addLv(lp, lw, ln, dL, 3.0, "Prior-day low", px, lim)
        addLv(lp, lw, ln, dC, 1.0, "Prior-day close", px, lim)
        addLv(lp, lw, ln, pvP, 1.5, "Daily pivot", px, lim)
        addLv(lp, lw, ln, 2 * pvP - dL, 1.5, "Pivot R1", px, lim)
        addLv(lp, lw, ln, 2 * pvP - dH, 1.5, "Pivot S1", px, lim)
        addLv(lp, lw, ln, pvP + (dH - dL), 1.0, "Pivot R2", px, lim)
        addLv(lp, lw, ln, pvP - (dH - dL), 1.0, "Pivot S2", px, lim)
        addLv(lp, lw, ln, wH, 2.5, "Prior-week high", px, lim)
        addLv(lp, lw, ln, wL, 2.5, "Prior-week low", px, lim)
        addLv(lp, lw, ln, d20H, 2.0, "20-day high", px, lim)
        addLv(lp, lw, ln, d20L, 2.0, "20-day low", px, lim)
        addLv(lp, lw, ln, dE20, 1.0, "20-day EMA", px, lim)
        addLv(lp, lw, ln, dE50, 1.0, "50-day EMA", px, lim)
        if dlSwing
            for v in array.from(sh0, sh1, sh2, sh3)
                addLv(lp, lw, ln, v, 1.5, "Daily swing high", px, lim)
            for v in array.from(sl0, sl1, sl2, sl3)
                addLv(lp, lw, ln, v, 1.5, "Daily swing low", px, lim)
        float step  = dlStep > 0 ? dlStep : math.pow(10, math.floor(math.log10(px))) / 20
        float lo1   = math.floor(px / step) * step
        float step2 = step * 2
        float lo2   = math.floor(px / step2) * step2
        addLv(lp, lw, ln, lo1, 0.5, "Round number", px, lim)
        addLv(lp, lw, ln, lo1 + step, 0.5, "Round number", px, lim)
        addLv(lp, lw, ln, lo2, 1.0, "Round number", px, lim)
        addLv(lp, lw, ln, lo2 + step2, 1.0, "Round number", px, lim)
        if str.length(dlAn) > 0
            for sx in str.split(dlAn, ",")
                addLv(lp, lw, ln, str.tonumber(str.replace_all(sx, " ", "")), 2.5, "Analyst level", px, lim)
        // merge nearby levels into zones
        float tol = math.max(dAtr * dlMerge, px * 0.0012)
        array<float>  zLo = array.new<float>()
        array<float>  zHi = array.new<float>()
        array<float>  zW  = array.new<float>()
        array<string> zN  = array.new<string>()
        if lp.size() > 0
            array<int> ord = lp.sort_indices(order.ascending)
            for i in ord
                float  p = lp.get(i)
                float  w = lw.get(i)
                string n = ln.get(i)
                int    k = zLo.size()
                if k > 0 and p - zHi.get(k - 1) <= tol
                    zHi.set(k - 1, p)
                    zW.set(k - 1, zW.get(k - 1) + w)
                    if not str.contains(zN.get(k - 1), n)
                        zN.set(k - 1, zN.get(k - 1) + "\n" + n)
                else
                    zLo.push(p)
                    zHi.push(p)
                    zW.push(w)
                    zN.push(n)
        int dStart = time("D")
        int x1 = na(dStart) ? time - 50 * timeframe.in_seconds() * 1000 : dStart
        int x2 = time + dlExt * timeframe.in_seconds() * 1000
        int zc = zLo.size()
        if zc > 0
            float hpad = tol * 0.25
            int nR = 0
            for j = 0 to zc - 1
                float lo = zLo.get(j)
                float hi = zHi.get(j)
                if lo > px and nR < dlN
                    nR += 1
                    if nR == 1
                        dR1lo := lo
                        dR1hi := hi
                    if showDL
                        float w  = zW.get(j)
                        string tg = "D1 SELL ZONE R" + str.tostring(nR)
                        dlB.push(box.new(x1, hi + hpad, x2, lo - hpad, xloc = xloc.bar_time, border_color = color.new(cSell, 100), bgcolor = color.new(cSell, w >= 4 ? 84 : 90)))
                        dlL.push(line.new(x1, (lo + hi) / 2, x2, (lo + hi) / 2, xloc = xloc.bar_time, color = color.new(cSell, w >= 2.5 ? 20 : 50), width = w >= 6 ? 3 : w >= 4 ? 2 : 1))
                        dlT.push(label.new(x2, (lo + hi) / 2, tg + "  " + rngTxt(lo, hi), xloc = xloc.bar_time, style = label.style_label_left, color = color.new(cSell, 100), textcolor = cSell, size = size.small, tooltip = tg + " · strength " + str.tostring(w, "#.#") + "\n" + zN.get(j)))
            int nS = 0
            for j = zc - 1 to 0
                float lo = zLo.get(j)
                float hi = zHi.get(j)
                if hi < px and nS < dlN
                    nS += 1
                    if nS == 1
                        dS1lo := lo
                        dS1hi := hi
                    if showDL
                        float w  = zW.get(j)
                        string tg = "D1 BUY ZONE S" + str.tostring(nS)
                        dlB.push(box.new(x1, hi + hpad, x2, lo - hpad, xloc = xloc.bar_time, border_color = color.new(cBuy, 100), bgcolor = color.new(cBuy, w >= 4 ? 84 : 90)))
                        dlL.push(line.new(x1, (lo + hi) / 2, x2, (lo + hi) / 2, xloc = xloc.bar_time, color = color.new(cBuy, w >= 2.5 ? 20 : 50), width = w >= 6 ? 3 : w >= 4 ? 2 : 1))
                        dlT.push(label.new(x2, (lo + hi) / 2, tg + "  " + rngTxt(lo, hi), xloc = xloc.bar_time, style = label.style_label_left, color = color.new(cBuy, 100), textcolor = cBuy, size = size.small, tooltip = tg + " · strength " + str.tostring(w, "#.#") + "\n" + zN.get(j)))

// ───────────────────────────── Local structure → zones
if bosDn
    slUsed  := true
    trend   := -1
    lastBos := slP
    if showBos
        bosLn.push(line.new(slB, slP, bar_index, slP, color = color.new(cSell, 50), style = line.style_dotted))
        bosLb.push(label.new(bar_index, slP, "BOS", style = label.style_label_upper_left, color = color.new(color.black, 100), textcolor = color.new(cSell, 30), size = size.tiny))
    bool forming = false
    for z in zLive
        if z.dir < 0 and z.state == 0
            forming := true
    if not forming
        [p0, b0] = legStart(-1, shB)
        zLive.push(newZone(-1, p0, b0, dKey))

if bosUp
    shUsed  := true
    trend   := 1
    lastBos := shP
    if showBos
        bosLn.push(line.new(shB, shP, bar_index, shP, color = color.new(cBuy, 50), style = line.style_dotted))
        bosLb.push(label.new(bar_index, shP, "BOS", style = label.style_label_lower_left, color = color.new(color.black, 100), textcolor = color.new(cBuy, 30), size = size.tiny))
    bool forming = false
    for z in zLive
        if z.dir > 0 and z.state == 0
            forming := true
    if not forming
        [p0, b0] = legStart(1, slB)
        zLive.push(newZone(1, p0, b0, dKey))

var string lastTrade    = "—"
var int    lastTradeDir = 0
string cLbl = tfLabel(timeframe.period)

// ───────────────────────────── Open trade → outcome (before new entries, so a trade that closes on this bar frees the slot)
for t in tLive
    if t.state == 1
        for l in t.ln
            l.set_x2(bar_index)
        if barstate.isconfirmed and bar_index > t.eB
            bool   done = false
            string res  = ""
            bool   hitSl = t.dir < 0 ? high >= t.sl : low <= t.sl
            if hitSl
                t.net += t.rem * t.dir * (t.sl - t.entry)
                t.rem := 0.0
                done  := true
                res   := t.hits == 0 ? "✗ SL" : "✓ TP" + str.tostring(t.hits) + (t.sl == t.entry ? " · BE" : t.dir * (t.sl - t.entry) > 0 ? " · locked" : " · reversed")
                if t.hits == 0
                    score(t.dKey, 2, 1)
                    t.zn.entries := maxEnt
            else
                int before = t.hits
                while t.hits < 4 and (t.dir < 0 ? low <= t.tps.get(t.hits) : high >= t.tps.get(t.hits))
                    t.net += 0.25 * math.abs(t.tps.get(t.hits) - t.entry)
                    t.rem -= 0.25
                    t.hits += 1
                if t.hits > before
                    if before == 0
                        score(t.dKey, 1, 1)
                    t.sl := protSl(t.dir, t.entry, t.sl, t.hits)
                    if t.ln.size() > 0
                        t.ln.get(0).set_y1(t.sl)
                        t.ln.get(0).set_y2(t.sl)
                    t.lb.set_text((t.dir < 0 ? "SELL" : "BUY") + (t.add ? " +" : "") + " ✓TP" + str.tostring(t.hits) + " · open")
                if t.hits == 4
                    done := true
                    res  := "✓ TP4"
                else if bar_index - t.eB >= maxBars
                    t.net += t.rem * t.dir * (close - t.entry)
                    t.rem := 0.0
                    done  := true
                    res   := (t.hits > 0 ? "✓ TP" + str.tostring(t.hits) + " · " : "") + "⌛"
                    if t.hits == 0 and t.net < 0
                        score(t.dKey, 2, 1)
            if done
                closeTrade(t, res)
                lastTrade    := (t.dir < 0 ? "SELL " : "BUY ") + fmtP(t.entry) + " → " + sgnPts(t.net)
                lastTradeDir := t.dir

bool busy = false
for t in tLive
    if t.state == 1
        busy := true

// ───────────────────────────── Local zones → entries
bool evSellZone  = false
bool evBuyZone   = false
bool evSellEntry = false
bool evBuyEntry  = false

for z in zLive
    if z.state <= 1
        legUpdate(z)
        float zA    = lvl(z, fEntry)
        float zB    = lvl(z, fZone)
        float zM    = (zA + zB) / 2
        bool  valid = math.abs(z.p0 - z.p1) >= minLeg * atr
        color cDir  = z.dir < 0 ? cSell : cBuy
        if valid
            float  top = math.max(zA, zB)
            float  bot = math.min(zA, zB)
            string tx  = cLbl + (z.dir < 0 ? " SELL ZONE " : " BUY ZONE ") + pct(fEntry) + "–" + pct(fZone) + (trig != "Rejection candle" and trig != "Touch" ? " · mid " + fmtP(zM) : "")
            if na(z.bx)
                z.bx  := box.new(z.b1, top, bar_index + 3, bot, border_color = color.new(cDir, 25), border_style = line.style_dashed, border_width = 1, bgcolor = color.new(cZone, 86), text = tx, text_size = size.tiny, text_color = cDir, text_halign = text.align_right, text_valign = z.dir < 0 ? text.align_top : text.align_bottom)
                z.mid := line.new(z.b1, zM, bar_index + 3, zM, color = color.new(cZone, 30), style = line.style_dashed)
                if showLeg
                    z.lg := line.new(z.b0, z.p0, z.b1, z.p1, color = color.new(cZone, 45), style = line.style_dashed)
            else
                z.bx.set_lefttop(z.b1, top)
                z.bx.set_rightbottom(bar_index + 3, bot)
                z.bx.set_text(tx)
                z.mid.set_xy1(z.b1, zM)
                z.mid.set_xy2(bar_index + 3, zM)
                if not na(z.lg)
                    z.lg.set_xy1(z.b0, z.p0)
                    z.lg.set_xy2(z.b1, z.p1)
        [fire, ep, sl, dist, tNow, sbSl] = zoneEval(z, atr, spkBlock, trend, busy or (z.dir > 0 ? blkBuy : blkSell))
        if tNow
            if z.dir < 0
                evSellZone := true
            else
                evBuyZone := true
        if fire
            bool  add = z.entries > 1
            array<float> tps = array.from(ep + z.dir * tp1Pts, ep + z.dir * tp2Pts, ep + z.dir * tp3Pts, ep + z.dir * tp4Pts)
            string side = z.dir < 0 ? "SELL" : "BUY"
            string tip  = cLbl + " " + side + (add ? " (reinforcement)" : "") + " @ " + fmtP(ep) + "\nSL " + fmtP(sl) + " (" + str.tostring(dist, "#.##") + " pts)\nTP1 " + fmtP(tps.get(0)) + " · TP2 " + fmtP(tps.get(1)) + "\nTP3 " + fmtP(tps.get(2)) + " · TP4 " + fmtP(tps.get(3)) + "\nZone " + fmtP(math.min(zA, zB)) + " – " + fmtP(math.max(zA, zB)) + "\nLeg " + fmtP(z.p0) + " → " + fmtP(z.p1)
            label lb = label.new(bar_index, z.dir < 0 ? high : low, side + (add ? " +" : ""), style = z.dir < 0 ? label.style_label_down : label.style_label_up, color = z.dir < 0 ? #E0475F : #00A884, textcolor = color.white, size = add ? size.tiny : size.small, tooltip = tip)
            array<line> ln = array.new<line>()
            if showLn
                ln.push(line.new(bar_index, sl, bar_index + 1, sl, color = color.new(cSell, 20), style = line.style_dashed))
                for p in tps
                    ln.push(line.new(bar_index, p, bar_index + 1, p, color = color.new(cBuy, 45), style = line.style_dotted))
                ln.push(line.new(bar_index, ep, bar_index + 1, ep, color = color.new(color.white, 30), style = line.style_solid))
            Trade nt = Trade.new(z.dir, ep, sl, dist, tps, 0, bar_index, dKey, 0.0, 1.0, 1, add, lb, ln, z)
            tLive.push(nt)
            busy := true
            score(dKey, 0, 1)
            lastTrade    := side + " " + fmtP(ep) + " · open"
            lastTradeDir := z.dir
            if z.dir < 0
                evSellEntry := true
            else
                evBuyEntry := true
            alert("FOXREX Waves " + cLbl + " " + side + (add ? " (add)" : "") + " " + syminfo.ticker + " @ " + fmtP(ep) + " | SL " + fmtP(sl) + " | TP1 " + fmtP(tps.get(0)) + " | TP2 " + fmtP(tps.get(1)) + " | TP3 " + fmtP(tps.get(2)) + " | TP4 " + fmtP(tps.get(3)), alert.freq_once_per_bar_close)
            // limit fill: if the same candle also reached the stop, the trade is a loss (worst case)
            if sbSl
                nt.net := -dist
                nt.rem := 0.0
                score(dKey, 2, 1)
                z.entries := maxEnt
                closeTrade(nt, "✗ SL")
                busy      := false
                lastTrade := side + " " + fmtP(ep) + " → " + sgnPts(nt.net)
        if z.state >= 10
            zoneFade(z)

// ───────────────────────────── Housekeeping
if zLive.size() > 0
    for i = zLive.size() - 1 to 0
        Zone z = zLive.get(i)
        if z.state >= 10
            zLive.remove(i)
            zArch.push(z)
while zArch.size() > keepZ
    zoneWipe(zArch.shift())

if tLive.size() > 0
    for i = tLive.size() - 1 to 0
        Trade t = tLive.get(i)
        if t.state >= 10
            tLive.remove(i)
            tArch.push(t)
while tArch.size() > keepN
    label.delete(tArch.shift().lb)

while bosLn.size() > 60
    line.delete(bosLn.shift())
while bosLb.size() > 60
    label.delete(bosLb.shift())

// ───────────────────────────── Alerts
alertcondition(evSellZone, "Sell zone reached", "FOXREX Waves: price reached a SELL zone on {{ticker}} {{interval}}")
alertcondition(evBuyZone, "Buy zone reached", "FOXREX Waves: price reached a BUY zone on {{ticker}} {{interval}}")
alertcondition(evSellEntry, "Sell entry", "FOXREX Waves: SELL entry on {{ticker}} {{interval}}")
alertcondition(evBuyEntry, "Buy entry", "FOXREX Waves: BUY entry on {{ticker}} {{interval}}")

// ───────────────────────────── Dashboard
var table tb = table.new(tbPos == "Top left" ? position.top_left : tbPos == "Bottom right" ? position.bottom_right : tbPos == "Bottom left" ? position.bottom_left : position.top_right, 2, 8, bgcolor = color.new(#0B1320, 10), frame_color = color.new(#A7B6C4, 70), frame_width = 1)

if barstate.islast and showTb
    string sellTxt = "—"
    string buyTxt  = "—"
    for z in zLive
        if z.state <= 1 and not na(z.bx)
            string st = spkBlock and z.touched ? "spike filter" : z.entries > 0 ? str.tostring(z.entries) + " entr" + (z.entries > 1 ? "ies" : "y") : z.touched ? "in zone" : "waiting"
            string zt = fmtP(math.min(lvl(z, fEntry), lvl(z, fZone))) + " – " + fmtP(math.max(lvl(z, fEntry), lvl(z, fZone))) + " · " + st
            if z.dir < 0
                sellTxt := zt
            else
                buyTxt := zt
    string openTxt = "none"
    int    openDir = 0
    for t in tLive
        if t.state == 1
            openTxt := (t.dir < 0 ? "SELL " : "BUY ") + fmtP(t.entry) + (t.hits > 0 ? " · ✓TP" + str.tostring(t.hits) : "") + " · SL " + fmtP(t.sl)
            openDir := t.dir
    string majTxt = not majOn ? "off" : (mTr < 0 ? "Bearish" : mTr > 0 ? "Bullish" : "—") + (majBuyAct ? " · in BUY zone" : majSellAct ? " · in SELL zone" : "") + (mTDir != 0 ? " · " + (mTDir < 0 ? "SELL" : "BUY") + " open" : "")
    color cTxt = #E5E7EB
    color cMut = #8A97A8
    table.cell(tb, 0, 0, "FOXREX Waves", text_color = #F5B942, text_size = size.small, text_halign = text.align_left)
    table.cell(tb, 1, 0, syminfo.ticker + " · " + cLbl, text_color = cTxt, text_size = size.small, text_halign = text.align_right)
    table.cell(tb, 0, 1, "Structure " + cLbl, text_color = cMut, text_size = size.small, text_halign = text.align_left)
    table.cell(tb, 1, 1, trend < 0 ? "Bearish · BOS " + fmtP(lastBos) : trend > 0 ? "Bullish · BOS " + fmtP(lastBos) : "—", text_color = trend < 0 ? cSell : trend > 0 ? cBuy : cMut, text_size = size.small, text_halign = text.align_right)
    table.cell(tb, 0, 2, "Major " + mLbl, text_color = cMut, text_size = size.small, text_halign = text.align_left)
    table.cell(tb, 1, 2, majTxt, text_color = majBuyAct ? cBuy : majSellAct ? cSell : mTr < 0 ? cSell : mTr > 0 ? cBuy : cMut, text_size = size.small, text_halign = text.align_right)
    table.cell(tb, 0, 3, "Sell zone", text_color = cMut, text_size = size.small, text_halign = text.align_left)
    table.cell(tb, 1, 3, sellTxt, text_color = cSell, text_size = size.small, text_halign = text.align_right)
    table.cell(tb, 0, 4, "Buy zone", text_color = cMut, text_size = size.small, text_halign = text.align_left)
    table.cell(tb, 1, 4, buyTxt, text_color = cBuy, text_size = size.small, text_halign = text.align_right)
    table.cell(tb, 0, 5, "Open trade", text_color = cMut, text_size = size.small, text_halign = text.align_left)
    table.cell(tb, 1, 5, openTxt, text_color = openDir < 0 ? cSell : openDir > 0 ? cBuy : cMut, text_size = size.small, text_halign = text.align_right)
    table.cell(tb, 0, 6, "Last trade", text_color = cMut, text_size = size.small, text_halign = text.align_left)
    table.cell(tb, 1, 6, lastTrade, text_color = lastTradeDir < 0 ? cSell : lastTradeDir > 0 ? cBuy : cMut, text_size = size.small, text_halign = text.align_right)
    table.cell(tb, 0, 7, "Daily R1 / S1", text_color = cMut, text_size = size.small, text_halign = text.align_left)
    table.cell(tb, 1, 7, (na(dR1lo) ? "—" : rngTxt(dR1lo, dR1hi)) + "  /  " + (na(dS1lo) ? "—" : rngTxt(dS1lo, dS1hi)), text_color = cTxt, text_size = size.small, text_halign = text.align_right)

// ───────────────────────────── Daily scorecard
var table st = table.new(stPos == "Top left" ? position.top_left : stPos == "Top right" ? position.top_right : stPos == "Bottom left" ? position.bottom_left : position.bottom_right, 6, 4, bgcolor = color.new(#0B1320, 10), frame_color = color.new(#A7B6C4, 70), frame_width = 1)

stRow(table t, int r, string name, array<float> a) =>
    float n  = a.get(0)
    float w  = a.get(1)
    float l  = a.get(2)
    float pt = a.get(3)
    float wr = n > 0 ? w / n * 100 : na
    color cT = #E5E7EB
    table.cell(t, 0, r, name, text_color = #8A97A8, text_size = size.small, text_halign = text.align_left)
    table.cell(t, 1, r, str.tostring(n, "#"), text_color = cT, text_size = size.small)
    table.cell(t, 2, r, str.tostring(w, "#"), text_color = #00D4A7, text_size = size.small)
    table.cell(t, 3, r, str.tostring(l, "#"), text_color = #FF5C7A, text_size = size.small)
    table.cell(t, 4, r, na(wr) ? "—" : str.tostring(wr, "#") + "%", text_color = na(wr) ? #8A97A8 : wr >= 50 ? #00D4A7 : #FF5C7A, text_size = size.small)
    table.cell(t, 5, r, (pt > 0 ? "+" : "") + str.tostring(pt, "#.##"), text_color = pt > 0 ? #00D4A7 : pt < 0 ? #FF5C7A : cT, text_size = size.small)
    true

if barstate.islast and showSt
    color cH = #F5B942
    table.cell(st, 0, 0, "Scorecard " + cLbl, text_color = cH, text_size = size.small, text_halign = text.align_left)
    table.cell(st, 1, 0, "Trades", text_color = cH, text_size = size.small)
    table.cell(st, 2, 0, "Win", text_color = cH, text_size = size.small)
    table.cell(st, 3, 0, "Loss", text_color = cH, text_size = size.small)
    table.cell(st, 4, 0, "Win %", text_color = cH, text_size = size.small)
    table.cell(st, 5, 0, "Net pts", text_color = cH, text_size = size.small)
    stRow(st, 1, "Today", stT)
    stRow(st, 2, "Yesterday", stY)
    stRow(st, 3, "All on chart", stA)
