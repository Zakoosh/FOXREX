// FOXREX · Wave Retracement Zones · version 3.13 (see tools/tradingview/CHANGELOG.md)
// Three kinds of buy / sell zones, each with its own look so nothing overlaps:
//   • Local zones  — the chart's timeframe: grey fill, dashed border in the side colour, "M5 BUY ZONE".
//   • Major zones  — a higher timeframe that sets the direction (auto: 1m→15m, 5m→1H, 15m→4H, 1H→D):
//                    coloured fill, solid border, "H1 BUY ZONE · MAJOR". A local zone that sits inside a
//                    major zone of the same side is not drawn twice.
//   • Daily zones  — today's daily support (buy) / resistance (sell): light band with the name at the right edge.
// The strategy (fixed): a wave runs from its start to the first price stall. Its retracement gives the trade —
// buy after an up wave that made a higher high, sell after a down wave that made a lower low.
// Zone = 38.2%–61.8% of the wave, entry at the middle (50%) or on a rejection candle inside the zone, stop beyond
// 78.6% (capped by timeframe). At most two live zones per side per timeframe; finished zones are removed.
// Trend lines are drawn through the last two swing highs and the last two swing lows.
// Trades come only from these zones:
//   • local zone: limit at the middle of the zone or a rejection candle in it, whichever comes first;
//   • major zone: same rule on the major zone, seen on the chart timeframe;
//   • daily zone: a candle that dips into the zone and closes back out of it (rejection).
// Every timeframe trades its own setups: a short-term move against the bigger wave is allowed (the direction
// filter is off by default). One trade at a time per timeframe; a new signal never closes it.
// Targets and stops follow the timeframe (auto profile) — the stop sits beyond the zone, capped:
//   1m  TP 1 / 2 / 3 / 5      stop up to 5    (quick scalps)
//   5m  TP 2.5 / 5 / 10 / 15  stop up to 10
//   15m TP 2.5 / 5 / 10 / 20  stop up to 10
//   1H / 4H TP 5 / 10 / 20 / 40  stop up to 15    D/W/M: TP 10 / 20 / 40 / 80, stop up to 25
//   Trades from major and daily zones use at least the 5m targets.
// Simulation: every trade = 1 lot, no spread, commission per lot (default $6); P&L in $ on the label and scorecard.
// A trade that has not reached TP1 within "No-progress exit" bars is closed at market (time exit), and every
// trade is closed after "Maximum trade life" bars. Profit protection: stop to entry after TP1, to TP1 after
// TP2, to TP2 after TP3. A trade that touched a target is a win and is recorded as that target (a short line
// marks the target level reached); it is never shown as a stop loss.
// Daily scorecard per timeframe at the bottom. Nothing repaints: decisions use closed bars, higher timeframes
// are read from their last closed bar.
// Educational tool, not investment advice.

//@version=6
indicator("FOXREX · Wave Retracement Zones", shorttitle = "FOXREX Waves", overlay = true, max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500, max_bars_back = 500)
string VER = "3.13"

// ───────────────────────────── Inputs
string G_TR   = "1 · Trading & simulation"
bool   lotStar = input.bool(true, "Simulation size by confidence (1 / 1.5 / 2 / 2.5 lots for 1 to 4 stars)", group = G_TR, display = display.none)
float  lotVal  = input.float(0.0, "Simulation: $ per 1.0 move for 1 lot (0 = auto)", minval = 0.0, step = 1.0, group = G_TR, tooltip = "Auto: 100 for gold (1 lot = 100 oz), otherwise the symbol's point value. Every trade is simulated with 1 lot and no spread.", display = display.none)
float  comm    = input.float(6.0, "Simulation: commission per lot ($)", minval = 0.0, step = 0.5, group = G_TR, display = display.none)
int    maxOpen = input.int(0, "Max open trades in the same direction (0 = no limit)", minval = 0, group = G_TR, tooltip = "A new trade (faster entries on the next waves) opens only when every open trade is already protected (stop at entry or better) and in the same direction.", display = display.none)
string acct    = input.string("Highest target reached", "Result points", options = ["Highest target reached", "25% closed at each target"], group = G_TR, display = display.none)

string G_DIR  = "2 · Direction & filters"
string dirMode = input.string("With the trend (buy up, sell down, none in a range)", "Trade direction", options = ["With the trend (buy up, sell down, none in a range)", "Both directions", "Buy only", "Sell only"], group = G_DIR, tooltip = "With the trend (default): wave zones give buys only in an uptrend and sells only in a downtrend, nothing in a range (break zones still trade). Both directions: buys and sells from every zone whatever the trend. Buy only / Sell only: one side only. Reversal trades follow the same choice.", display = display.none)
bool   useRsi  = input.bool(true, "RSI filter: no sell below 30, no buy above 70", group = G_DIR, display = display.none)
int    rsiLen  = input.int(14, "RSI length", minval = 2, group = G_DIR, inline = "rsi", display = display.none)
float  rsiOS   = input.float(30, "below", group = G_DIR, inline = "rsi", display = display.none)
float  rsiOB   = input.float(70, "above", group = G_DIR, inline = "rsi", display = display.none)
bool   useRoom = input.bool(true, "Room filter: no sell just above support, no buy just under resistance", group = G_DIR, tooltip = "Blocks a sell when a daily support zone is or a live major BUY zone is closer than TP1 below price (TP2 on 1m), and the reverse for buys.", display = display.none)
int    swLen   = input.int(5, "Structure swing length (bars each side)", minval = 2, maxval = 50, group = G_DIR, display = display.none)
int    rngBars = input.int(0, "Range: no break of a swing high / low for (bars, 0 = auto)", minval = 0, group = G_DIR, tooltip = "Trend = direction of the last close beyond a swing high (up) or swing low (down). If neither side breaks for this long the market is a range. Auto: 1m 30 min · 2–5m 30 min · 6–15m 1 hour · higher 6 bars. A zone made by a fresh break can still trade in a range while it is younger than this.", display = display.none)
bool   useSpk  = input.bool(true, "Skip signals after an abnormal candle", group = G_DIR, display = display.none)
float  spkK    = input.float(2.5, "Abnormal = range above (× ATR)", minval = 1.0, step = 0.1, group = G_DIR, display = display.none)
int    spkLook = input.int(3, "Look back (bars)", minval = 1, maxval = 20, group = G_DIR, display = display.none)

string G_WAV  = "3 · Waves & zones"
int    stL     = input.int(3, "Stall: bars before the turn", minval = 1, maxval = 20, group = G_WAV, display = display.none)
int    ms1     = input.int(1, "Minimum stars to trade · 1m", options = [1, 2, 3], group = G_WAV, inline = "ms", tooltip = "A stall is found after one candle without a new high (low). Every further candle that holds near the top (within 23.6% of the wave) adds a star, up to 3. A fourth star is added when RSI was oversold (buy) or overbought (sell) in the last 10 bars. 1 = the signal fires from a single stall candle.", display = display.none)
int    ms5     = input.int(1, "2–5m", options = [1, 2, 3], group = G_WAV, inline = "ms", display = display.none)
int    ms15    = input.int(1, "6–30m", options = [1, 2, 3], group = G_WAV, inline = "ms", display = display.none)
int    msH     = input.int(1, "above", options = [1, 2, 3], group = G_WAV, inline = "ms", display = display.none)
float  fEntry  = input.float(0.382, "Zone start (retracement)", minval = 0.236, maxval = 0.886, step = 0.01, group = G_WAV, display = display.none)
float  fZone   = input.float(0.618, "Zone end (retracement)", minval = 0.236, maxval = 0.95, step = 0.01, group = G_WAV, display = display.none)
float  fInv    = input.float(0.786, "Invalidation (retracement)", minval = 0.5, maxval = 1.0, step = 0.01, group = G_WAV, display = display.none)
float  minLeg  = input.float(1.5, "Minimum leg size (× ATR)", minval = 0.0, step = 0.1, group = G_WAV, display = display.none)
int    maxWait = input.int(300, "Zone life (bars after the leg end)", minval = 5, group = G_WAV, display = display.none)
bool   ovlOn   = input.bool(true, "Buy and sell zones overlapping: keep only the stronger", group = G_WAV, tooltip = "When a new buy zone overlaps a live sell zone (or the reverse), only one stays: the zone in the direction of the trend wins; in a range (or both with the trend) the bigger wave wins. Off = both zones stay, as in 3.12.", display = display.none)

string G_ENT  = "4 · Entry"
string trig    = input.string("Limit or rejection", "Entry type", options = ["Limit or rejection", "Limit only", "Rejection candle only"], group = G_ENT, tooltip = "Limit: filled the moment price reaches the entry level below. Rejection: a candle that touches the zone and closes back out of it, entered at its close (never more than one zone-height away from the zone). Limit or rejection: whichever comes first.", display = display.none)
string eLvl    = input.string("Zone middle (50%)", "Entry level (where the limit fills)", options = ["Zone middle (50%)", "Zone start (first touch)", "Zone end (deep)", "Custom retracement"], group = G_ENT, tooltip = "Zone start = the near edge (38.2%): earliest fill, most trades. Zone middle = 50% (default). Zone end = the far edge (61.8%): better price, fewer fills. Custom: any retracement of the wave, e.g. 0.5 or 0.705.", display = display.none)
float  eCust   = input.float(0.5, "Custom retracement", minval = 0.236, maxval = 0.95, step = 0.01, group = G_ENT, display = display.none)
